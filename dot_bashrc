# ============================================================================
# BASH CONFIGURATION (Minimal)
# ============================================================================
# Shell-specific features only. Universal config is in ~/.profile

# Source shared configuration
if [ -z "$PROFILE_SOURCED" ]; then
	export PROFILE_SOURCED=1
	[ -f "$HOME/.profile" ] && . "$HOME/.profile"
fi

# Non-interactive shells stop here (bash also reads .bashrc for `ssh host cmd`,
# scp and rsync): environment only, no prompt/fzf/completion, no output.
case $- in
	*i*) ;;
	*) return ;;
esac

# ----------------------------------------------------------------------------
# SHARED SNIPPETS
# ----------------------------------------------------------------------------
# Aliases (from .chezmoidata/shortcuts.toml) and fzf defaults + h(). Aliases and
# functions aren't inherited by child shells, so load them in every
# interactive shell rather than once in ~/.profile.

for snippet in aliases fzf; do
	[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/shell/$snippet.sh" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/shell/$snippet.sh"
done
unset snippet

# ----------------------------------------------------------------------------
# HISTORY
# ----------------------------------------------------------------------------

HISTSIZE=50000
HISTFILESIZE=50000
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/bash/history"
HISTCONTROL=ignoreboth:erasedups

shopt -s histappend cmdhist
PROMPT_COMMAND="history -a; $PROMPT_COMMAND"

# ----------------------------------------------------------------------------
# BASH OPTIONS
# ----------------------------------------------------------------------------

# Completion
if ! shopt -oq posix; then
	[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion
	[ -f /etc/bash_completion ] && . /etc/bash_completion
fi

# Globbing & Navigation
shopt -s checkwinsize nocaseglob extglob globstar 2>/dev/null
shopt -s cdspell dirspell 2>/dev/null

# ----------------------------------------------------------------------------
# FZF
# ----------------------------------------------------------------------------

# FZF key bindings (options set in ~/.profile)
if command -v fzf >/dev/null 2>&1; then
	eval "$(fzf --bash 2>/dev/null)"  # fzf >= 0.48; no-op on older builds
fi

# Homebrew bash-completion
[ -n "$HOMEBREW_PREFIX" ] && [ -f "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh" ] && . "$HOMEBREW_PREFIX/etc/profile.d/bash_completion.sh"

# ----------------------------------------------------------------------------
# PROMPT (oh-my-posh)
# ----------------------------------------------------------------------------

if command -v oh-my-posh &> /dev/null; then
	# Force color support for oh-my-posh
	export COLORTERM=truecolor
	eval "$(oh-my-posh init bash --config "${POSH_THEME:-${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-posh/theme.omp.json}")"
fi

# ----------------------------------------------------------------------------
# End of .bashrc
# ----------------------------------------------------------------------------
