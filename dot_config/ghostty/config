# Ghostty 1.3.x (macOS + Linux; macos-* keys are ignored on Linux)
# https://ghostty.org/docs/config/reference

# --- Font ---
font-family = JetBrainsMono Nerd Font
font-size = 14
font-thicken = true
adjust-cell-height = 1

# --- Theme (auto light/dark) ---
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

# --- Window ---
background-opacity = 0.85
background-blur = true
window-padding-x = 4,2
window-padding-y = 6,0
window-padding-balance = true
window-save-state = always
confirm-close-surface = false

# --- macOS ---
macos-titlebar-style = hidden
# Italian layout: both ⌥ keys type symbols (@ = ⌥ò, ~ = ⌥5, # [ ] { } `),
# so neither is Alt. For Alt shortcuts press Esc then the key
# (Esc b / Esc f: word back/forward; Esc c: fzf cd).
macos-option-as-alt = false
macos-icon = official
macos-window-shadow = true

# --- Cursor ---
cursor-style = block
cursor-style-blink = false
# Vivid mauve (Latte palette) chosen for cross-theme visibility: saturated enough
# to stand out on both Mocha dark and Latte cream backgrounds, and high-contrast
# against yellow vim diff highlights (DiffText/DiffChange).
cursor-color = #8839ef
cursor-text = #cdd6f4

# --- Shell ---
shell-integration = detect
shell-integration-features = no-cursor,ssh-env,ssh-terminfo
mouse-hide-while-typing = true
scrollback-limit = 1000000

# --- Scrollbar ---
scrollbar = never

# --- Clipboard ---
clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

# --- Splits ---
unfocused-split-opacity = 0.7
split-inherit-working-directory = true

# --- Quick Terminal ---
quick-terminal-position = top
quick-terminal-animation-duration = 0.08

# --- Notifications ---
notify-on-command-finish = unfocused
notify-on-command-finish-action = notify
notify-on-command-finish-after = 5s

# --- Keybindings ---
# Quick terminal (global)
keybind = global:cmd+grave_accent=toggle_quick_terminal

# Vim-style split navigation
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:bottom
keybind = ctrl+k=goto_split:top
keybind = ctrl+l=goto_split:right

# Split management (ctrl+a leader, tmux-like)
keybind = ctrl+a>h=new_split:left
keybind = ctrl+a>j=new_split:down
keybind = ctrl+a>k=new_split:up
keybind = ctrl+a>l=new_split:right
keybind = ctrl+a>f=toggle_split_zoom
keybind = ctrl+a>e=equalize_splits

# Utility
keybind = super+i=inspector:toggle
keybind = super+r=reload_config
