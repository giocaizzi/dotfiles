# Generated by chezmoi from Bitwarden Secrets Manager — do not edit.
# Change secrets in Bitwarden, then run `chezmoi apply`.
{{ range (includeTemplate "bws-secrets.json" . | fromJson) -}}
{{ if regexMatch "^[A-Za-z_][A-Za-z0-9_]*$" .key -}}
export {{ .key }}='{{ .value | replace "'" "'\\''" }}'
{{ end -}}
{{ end -}}
{{ if and (not (get . "work")) (get . "otelEndpoint") -}}
# guard plugin decision log (giocaizzi/harness): Claude Code and Copilot CLI strip
# OTEL_* from hook environments, so the guard reads these copies.
export GUARD_OTEL_EXPORTER_OTLP_ENDPOINT={{ .otelEndpoint | squote }}
export GUARD_OTEL_EXPORTER_OTLP_HEADERS="${OTEL_EXPORTER_OTLP_HEADERS:-}"
export GUARD_OTEL_RESOURCE_ATTRIBUTES='host.name={{ .chezmoi.hostname }}'
# Agent telemetry for Copilot: VS Code reads COPILOT_OTEL_* (it resolves this
# shell's env at launch); Copilot CLI reads only the standard endpoint, which is
# set for the copilot command alone so other OTel apps do not export here.
export COPILOT_OTEL_ENABLED=true
export COPILOT_OTEL_ENDPOINT={{ .otelEndpoint | squote }}
copilot() {
  OTEL_EXPORTER_OTLP_ENDPOINT={{ .otelEndpoint | squote }} OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf command copilot "$@"
}
{{ end -}}
