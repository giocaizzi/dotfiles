{{- $r := includeTemplate "aliases" (dict "shell" "posix" "ctx" .) | fromJson -}}
# ============================================================================
# SHARED SHELL ALIASES (POSIX)
# ============================================================================
# Rendered by chezmoi from .chezmoidata/aliases.toml — DO NOT EDIT directly.
# Sourced by ~/.bashrc and ~/.zshrc. POSIX-compliant: bash + zsh + sh.
# ============================================================================

# --- ls colours (GNU vs BSD flag, detected at runtime) ---
if ls --color=auto >/dev/null 2>&1; then
	alias ls='ls --color=auto'
else
	alias ls='ls -G'  # BSD ls (macOS)
fi

# --- Registry aliases ---
{{ range $name, $command := $r.aliases -}}
alias {{ $name }}='{{ replace "'" "'\\''" $command }}'
{{ end }}
# --- Refused commands (a function wins over a reinstalled binary) ---
{{ range $name, $block := $r.blocks -}}
{{ $name }}() {
	echo '{{ replace "'" "'\\''" $block.message }}' >&2
	return 1
}
{{ end }}
# --- Python ---
# Only where nothing provides `python` (uv does on full machines)
if ! command -v python >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
	alias python='python3'
fi
{{- if not (get . "light") }}

# --- Functions (full machines) ---
# Edit commands for the dotfiles (docs/OS.md#editing-your-dotfiles). They edit the chezmoi
# source checkout in place, then diff and optionally apply only the affected targets.

# _dots_pick <label> <choice>...: fzf picker, or a numbered prompt without fzf (prints
# nothing on an invalid number).
_dots_pick() (
	label=$1
	shift
	if command -v fzf >/dev/null 2>&1; then
		printf '%s\n' "$@" | fzf --prompt="$label> " --height=~100%
	else
		i=0
		for c do
			i=$((i + 1))
			printf '%s) %s\n' "$i" "$c" >&2
		done
		printf '%s [1-%s]: ' "$label" "$#" >&2
		read -r n
		case $n in '' | *[!0-9]*) return 0 ;; esac
		if [ "$n" -ge 1 ] && [ "$n" -le $# ]; then eval "printf '%s\n' \"\${$n}\""; fi
	fi
)

# _dots_open <file>: $EDITOR (then $VISUAL, then vi) on one file.
_dots_open() { sh -c "${EDITOR:-${VISUAL:-vi}} \"\$1\"" dots-edit "$1"; }

# _dots_edit [-1] <source file> <hook|-> <target>...: the shared edit flow.
# A plain file opens in the editor; an age file is decrypted to a private temp file,
# re-encrypted (armored) only when changed, and the temp file is always removed.
# Then `<hook> check <edited file>` (failure: nothing applied), `chezmoi diff` of the
# targets this machine manages (-1: the first only, when they render the same text),
# "apply now? [y/N]" for those targets only, `<hook> applied`, and a reminder to ship
# a PR. A subshell keeps umask and traps local.
_dots_edit() (
	first=
	if [ "$1" = -1 ]; then
		first=1
		shift
	fi
	file=$1 hook=$2
	shift 2
	src=$(chezmoi source-path) || return 1
	case $file in
	*.age)
		umask 077
		tmp=$(mktemp) || return 1
		trap 'rm -f "$tmp" "$src/$file.new"' EXIT
		trap 'exit 130' HUP INT TERM
		chezmoi decrypt "$src/$file" >"$tmp" || return 1
		before=$(cksum <"$tmp")
		_dots_open "$tmp" || return 1
		if [ "$(cksum <"$tmp")" != "$before" ]; then
			{ chezmoi encrypt "$tmp" >"$src/$file.new" &&
				mv "$src/$file.new" "$src/$file"; } || return 1
		fi
		edited=$tmp
		;;
	*)
		_dots_open "$src/$file" || return 1
		edited=$src/$file
		;;
	esac
	if [ "$hook" != - ] && ! "$hook" check "$edited"; then
		echo "Check failed, nothing applied. The source keeps the edit: run the command again to fix it ($src/$file)." >&2
		return 1
	fi
	# Keep the targets this machine manages: each original argument is shifted off,
	# the managed ones are appended as absolute paths.
	home=$(chezmoi target-path) || return 1
	managed=$(chezmoi managed -i files)
	for t do
		shift
		if printf '%s\n' "$managed" | grep -qxF "$t"; then set -- "$@" "$home/$t"; fi
	done
	if [ $# -gt 0 ]; then
		if [ -n "$first" ]; then chezmoi diff "$1"; else chezmoi diff "$@"; fi
		printf 'apply now? [y/N] ' >&2
		read -r answer
		case $answer in
		[yY]*)
			chezmoi apply "$@" || return 1
			if [ "$hook" != - ]; then "$hook" applied; fi
			;;
		esac
	fi
	changes=$(git -C "$src" status --short)
	if [ -n "$changes" ]; then
		echo "The dotfiles source changed: ship a PR (e.g. /ship) from $src" >&2
		printf '%s\n' "$changes" >&2
	fi
)

# agents-edit [core|env|personal|work]: a layer of the global agent instructions
# (docs/OS.md#agent-instructions). Every harness file renders the same text: one diff.
agents-edit() (
	layer=${1:-}
	[ -n "$layer" ] || layer=$(_dots_pick 'agent layer' core env personal work) || return 1
	case $layer in
	core | env) file=.chezmoitemplates/agents/$layer.md ;;
	personal | work) file=.chezmoitemplates/agents/$layer.md.age ;;
	*)
		echo 'usage: agents-edit [core|env|personal|work]' >&2
		return 2
		;;
	esac
	_dots_edit -1 "$file" - .claude/CLAUDE.md .copilot/copilot-instructions.md \
		.codex/AGENTS.md .config/opencode/AGENTS.md .pi/agent/AGENTS.md
)

# aliases-edit [public|private]: the alias registry or the encrypted personal aliases
# (docs/SHELL.md#alias-registry). The registry lint must pass before apply.
aliases-edit() (
	scope=${1:-}
	[ -n "$scope" ] || scope=$(_dots_pick aliases public private) || return 1
	case $scope in
	public) file=.chezmoidata/aliases.toml ;;
	private) file=.aliases.private.toml.age ;;
	*)
		echo 'usage: aliases-edit [public|private]' >&2
		return 2
		;;
	esac
	_dots_edit "$file" _aliases_edit_hook .config/shell/aliases.sh \
		.config/shell/omz-aliases.zsh .config/powershell/aliases.ps1
)
_aliases_edit_hook() {
	case $1 in
	check) make -C "$(chezmoi source-path)" lint-aliases ;;
	applied) echo "Aliases applied: open a new shell, or run . ${XDG_CONFIG_HOME:-$HOME/.config}/shell/aliases.sh" >&2 ;;
	esac
}

# ssh-edit [config|<name>]: the shared, encrypted ~/.ssh/config, or ~/.ssh/config.d/<name>
# (this machine's hosts, not managed by chezmoi: edited in place, a new name creates it).
# `ssh -G` must parse the edit (config: before apply). No argument: pick config or an
# existing config.d file.
ssh-edit() (
	if [ $# -gt 1 ]; then
		echo 'usage: ssh-edit [config|<name>]' >&2
		return 2
	fi
	dir=$(chezmoi target-path)/.ssh/config.d || return 1
	name=${1:-}
	if [ -z "$name" ]; then
		set -- config
		while IFS= read -r n; do
			if [ -f "$dir/$n" ]; then set -- "$@" "$n"; fi
		done <<EOF
$(ls -A "$dir" 2>/dev/null)
EOF
		name=$(_dots_pick 'ssh config' "$@") || return 1
	fi
	case $name in
	config)
		_dots_edit private_dot_ssh/encrypted_private_config.age _ssh_edit_hook .ssh/config
		return
		;;
	'' | .* | */*)
		echo 'usage: ssh-edit [config|<name>]' >&2
		return 2
		;;
	esac
	umask 077
	mkdir -p "$dir" && _dots_open "$dir/$name" || return 1
	if ! _ssh_edit_hook check "$dir/$name"; then
		echo "Check failed: the file keeps the edit, run ssh-edit $name to fix it ($dir/$name)." >&2
		return 1
	fi
)
_ssh_edit_hook() {
	if [ "$1" = check ]; then ssh -G -F "$2" localhost >/dev/null; fi
}
{{- end }}
{{- if and (eq .chezmoi.os "darwin") (not (get . "light")) (not (get . "work")) }}

# --- Functions (personal Mac) ---
# Swarm secrets sync from Secrets Manager. The token is read from chezmoi when the
# command runs and exists only in that process (never exported to the shell).
rp5-secrets() {
	BWS_ACCESS_TOKEN="$(chezmoi secret keyring get --service=bws --user=access-token)" \
		PI_SSH_USER="${PI_SSH_USER:-$USER}" \
		"$HOME/Documents/github/rp5-homeserver/scripts/create_secrets.sh" "$@"
}
# Infra stack deploy with its file-based secrets written from Secrets Manager (same token).
rp5-sync-infra() {
	BWS_ACCESS_TOKEN="$(chezmoi secret keyring get --service=bws --user=access-token)" \
		PI_SSH_USER="${PI_SSH_USER:-$USER}" DOMAIN="${DOMAIN:?export DOMAIN (the public zone)}" \
		"$HOME/Documents/github/rp5-homeserver/scripts/sync_infra.sh" "$@"
}
{{- end }}
