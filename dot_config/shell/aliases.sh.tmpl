# ============================================================================
# SHARED SHELL ALIASES (POSIX)
# ============================================================================
# Generated by chezmoi from .chezmoidata/shortcuts.toml — DO NOT EDIT directly.
# Sourced by ~/.profile. POSIX-compliant: bash + zsh + sh.
# ============================================================================

# --- Directory navigation ---
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# --- File listing (color-aware) ---
if ls --color=auto >/dev/null 2>&1; then
	alias ls='ls --color=auto'
else
	alias ls='ls -G'  # BSD ls (macOS)
fi
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'

# --- File ops & system ---
alias mkdir='mkdir -p'
alias df='df -h'
alias du='du -h'
alias grep='grep --color=auto'

# --- Platform-specific ---
{{- if eq .chezmoi.os "darwin" }}
alias free='top -l 1 -s 0 | grep PhysMem'
{{- end }}

# --- Project-specific ---
{{- if eq .chezmoi.os "darwin" }}
alias ikas="$HOME/Documents/iknowaspot/iknowaspot/ikas.sh"
alias openclaw="$HOME/Documents/github/rp5-homeserver/services/openclaw/openclaw.sh"
# Swarm secrets sync from Secrets Manager. The token is read from chezmoi when the
# command runs and exists only in that process (never exported to the shell).
rp5-secrets() {
	BWS_ACCESS_TOKEN="$(chezmoi secret keyring get --service=bws --user=access-token)" \
		PI_SSH_USER="${PI_SSH_USER:-$USER}" \
		"$HOME/Documents/github/rp5-homeserver/scripts/create_secrets.sh" "$@"
}
{{- end }}

# --- Python ---
# Only where nothing provides `python` (uv does on full machines)
if ! command -v python >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
	alias python='python3'
fi

# CLI tools come from uv; refuse pipx (a function wins over a reinstalled binary)
pipx() {
	echo "pipx is not used here, use uv: uv tool install <pkg> | uvx <pkg> | uv tool upgrade --all" >&2
	return 1
}

# --- Git shortcuts (generated from .chezmoidata/shortcuts.toml) ---
{{ range $name, $cmd := .shortcuts.git -}}
alias {{ $name }}='{{ $cmd }}'
{{ end }}
