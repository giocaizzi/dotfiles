{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "#cdd6f4",
          "template": "<#89b4fa>\u250c</><#6c7086>[</>\uf007 {{ .UserName }}@{{ .HostName }}<#6c7086>]</>",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "root",
          "style": "plain",
          "foreground": "#f9e2af",
          "template": " <#6c7086>[</>\uf0e7 root<#6c7086>]</>",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#f38ba8",
          "template": " <#6c7086>[</>\ue725 {{ .HEAD }}{{ if gt .Ahead 0 }} \u2191{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} \u2193{{ .Behind }}{{ end }}{{ if or .Working.Changed .Staging.Changed }} *{{ end }}<#6c7086>]</>",
          "properties": {
            "cache_duration": "none",
            "branch_icon": "",
            "fetch_status": true
          }
        },
        {
          "type": "gcp",
          "style": "plain",
          "foreground": "#f9e2af",
          "template": "{{ if .Project }} <#6c7086>[</>\uf0c2 {{ .Project }}<#6c7086>]</>{{ end }}",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "az",
          "style": "plain",
          "foreground": "#89b4fa",
          "template": "{{ if .Name }} <#6c7086>[</>\uebd8 {{ .Name }}<#6c7086>]</>{{ end }}",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "azd",
          "style": "plain",
          "foreground": "#89b4fa",
          "template": "{{ if .DefaultEnvironment }} <#6c7086>[</>\uebd8 azd {{ .DefaultEnvironment }}<#6c7086>]</>{{ end }}",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "aws",
          "style": "plain",
          "foreground": "#fab387",
          "template": "{{ if .Profile }} <#6c7086>[</>\uf270 {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }}<#6c7086>]</>{{ end }}",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "kubectl",
          "style": "plain",
          "foreground": "#89b4fa",
          "template": "{{ if .Context }} <#6c7086>[</>\ue81d {{ .Context }}{{ if .Namespace }}::{{ .Namespace }}{{ end }}<#6c7086>]</>{{ end }}",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "python",
          "style": "plain",
          "foreground": "#cdd6f4",
          "template": " <#6c7086>[</>\ue235 {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}<#6c7086>]</>",
          "properties": {
            "cache_duration": "none"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "break",
      "segments": [
        {
          "type": "sysinfo",
          "style": "plain",
          "foreground": "#cdd6f4",
          "template": "<#6c7086>[</>\uefc5 {{ div ((sub .PhysicalTotalMemory .PhysicalFreeMemory)|float64) 1073741824.0 }}/{{ div .PhysicalTotalMemory 1073741824.0 }}GB<#6c7086>]</>",
          "foreground_templates": [
            "{{ if gt .PhysicalPercentUsed 80.0 }}#f9e2af{{ end }}"
          ],
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "battery",
          "style": "plain",
          "foreground": "#cdd6f4",
          "template": "{{ if not .Error }} <#6c7086>[</>{{ if ge .Percentage 88 }}\uf240{{ else if ge .Percentage 63 }}\uf241{{ else if ge .Percentage 38 }}\uf242{{ else if ge .Percentage 13 }}\uf243{{ else }}\uf244{{ end }} {{ .Percentage }}%{{ if eq \"Charging\" .State.String }} \uf1e6{{ end }}<#6c7086>]</>{{ end }}",
          "foreground_templates": [
            "{{ if eq \"Charging\" .State.String }}#a6e3a1{{ end }}",
            "{{ if and (eq \"Discharging\" .State.String) (lt .Percentage 20) }}#f38ba8{{ end }}"
          ],
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#cdd6f4",
          "template": " <#6c7086>[</>\uf017 {{ .CurrentDate | date .Format }}<#6c7086>]</>",
          "properties": {
            "cache_duration": "none",
            "time_format": "15:04 Mon 02 Jan"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "style": "plain",
          "foreground": "#cba6f7",
          "template": "<#89b4fa>\u251c</><#6c7086>[</>\uf07c {{ .Path }}<#6c7086>]</>",
          "properties": {
            "cache_duration": "none",
            "style": "full"
          }
        },
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#cdd6f4",
          "template": " <#6c7086>[</>\uf520 {{ .FormattedMs }}<#6c7086>]</>",
          "properties": {
            "cache_duration": "none",
            "style": "austin",
            "threshold": 500
          }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#f38ba8",
          "template": " <#6c7086>[</>\uf071 exit {{ .Code }}<#6c7086>]</>",
          "properties": {
            "cache_duration": "none"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#89b4fa",
          "template": "\u2514\u0394",
          "properties": {
            "cache_duration": "none"
          }
        }
      ]
    }
  ],
  "final_space": true,
  "version": 3
}
