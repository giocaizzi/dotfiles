{{- /* chezmoi:modify-template */ -}}
{{- /* User-scope MCP servers (.chezmoidata/mcp.toml [mcp.user]) merged into
       opencode's config; other keys stay. The live file is read as JSON, so
       keep it free of comments. */ -}}
{{- $current := dict "$schema" "https://opencode.ai/config.json" -}}
{{- if .chezmoi.stdin }}{{ $current = fromJson .chezmoi.stdin }}{{ end -}}
{{- $servers := get $current "mcp" | default dict -}}
{{- range $n, $u := includeTemplate "mcp-servers.json" .mcp.user | fromJson }}{{ $_ := set $servers $n (dict "type" "remote" "url" $u "enabled" true) }}{{ end -}}
{{- $_ := set $current "mcp" $servers -}}
{{- $current | toPrettyJson }}
