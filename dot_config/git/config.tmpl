[user]
	name = {{ .gitUser }}
	email = {{ .gitEmail }}

{{- with get . "workGitDir" }}

# Repos under the work folder use the work email (~/.config/git/work)
[includeIf "gitdir/i:{{ . | replace "\\" "/" | trimSuffix "/" }}/"]
	path = work
{{- end }}
{{- with get . "workGitRemote" }}

# Repos with a matching remote URL use the work email, wherever they live
{{- range splitList "," . }}{{ with trim . }}
[includeIf "hasconfig:remote.*.url:{{ . }}"]
	path = work
{{- end }}{{ end }}
{{- end }}

[commit]
	template = {{ .chezmoi.homeDir }}/.config/git/commit-template

[init]
	defaultBranch = main

[submodule]
	recurse = true

[credential]
{{- if eq .chezmoi.os "darwin" }}
	helper = osxkeychain
{{- else if eq .chezmoi.os "windows" }}
	helper = wincred
{{- else if eq .chezmoi.os "linux" }}
	helper = cache --timeout=3600
{{- end }}

[diff]
	tool = vimdiff

[difftool "vimdiff"]
{{- if eq .chezmoi.os "windows" }}
	cmd = vim -d "$LOCAL" "$REMOTE"
{{- else }}
	cmd = vimdiff "$LOCAL" "$REMOTE"
{{- end }}

[merge]
	tool = vimdiff
	squash = true

[mergetool "vimdiff"]
{{- if eq .chezmoi.os "windows" }}
	cmd = vim -d "$LOCAL" "$REMOTE" "$MERGED"
{{- else }}
	cmd = vimdiff "$LOCAL" "$REMOTE" "$MERGED"
{{- end }}
	trustExitCode = true
