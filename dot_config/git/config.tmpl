[user]
	name = {{ .gitUser }}
{{- if get . "work" }}
	email = {{ .workEmail }}
{{- else }}
	email = {{ .gitEmail }}
{{- end }}
{{- with get . "personalGitRemote" }}

# Work machine: the work email is the default; repos with a matching remote
# URL use the personal email (~/.config/git/personal), wherever they live
{{- range splitList "," . }}{{ with trim . }}
[includeIf "hasconfig:remote.*.url:{{ . }}"]
	path = personal
{{- end }}{{ end }}
{{- end }}

[commit]
	template = {{ .chezmoi.homeDir }}/.config/git/commit-template

[init]
	defaultBranch = main

[submodule]
	recurse = true

[credential]
{{- if eq .chezmoi.os "darwin" }}
	helper = osxkeychain
{{- else if eq .chezmoi.os "windows" }}
	helper = wincred
{{- else if eq .chezmoi.os "linux" }}
	helper = cache --timeout=3600
{{- end }}

[diff]
	tool = vimdiff

[difftool "vimdiff"]
{{- if eq .chezmoi.os "windows" }}
	cmd = vim -d "$LOCAL" "$REMOTE"
{{- else }}
	cmd = vimdiff "$LOCAL" "$REMOTE"
{{- end }}

[merge]
	tool = vimdiff
	squash = true

[mergetool "vimdiff"]
{{- if eq .chezmoi.os "windows" }}
	cmd = vim -d "$LOCAL" "$REMOTE" "$MERGED"
{{- else }}
	cmd = vimdiff "$LOCAL" "$REMOTE" "$MERGED"
{{- end }}
	trustExitCode = true
