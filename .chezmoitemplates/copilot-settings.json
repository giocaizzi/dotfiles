{
  "extraKnownMarketplaces": {
    "giocaizzi-harness": {
      "source": {
        "source": "github",
        "repo": "giocaizzi/harness"
      }
    }
  },
  "enabledPlugins": {{ $on := dict }}{{ range $p, $h := .harnessPlugins }}{{ if has "copilot" $h }}{{ $_ := set $on (printf "%s@giocaizzi-harness" $p) (not (and (get $ "work") (has $p $.harnessPersonalPlugins))) }}{{ end }}{{ end }}{{ $on | toJson }},
  "statusLine": {
    "type": "command",
    "command": "node ~/.copilot/installed-plugins/giocaizzi-harness/hud/hooks/statusline.mjs"
  },
  "subagents": {
    "agents": {
      "dev-tools:scout": { "model": "gpt-6-luna", "effortLevel": "low" },
      "api:api-reviewer": { "model": "gpt-6.1-sol", "effortLevel": "medium" },
      "dev-tools:escalate": { "model": "gpt-6-astra", "effortLevel": "medium" },
      "dev-tools:driver": { "model": "gpt-6.1-sol", "effortLevel": "medium" },
      "dev-tools:reviewer": { "model": "gpt-6-luna", "effortLevel": "medium" },
      "dev-tools:worker": { "model": "gpt-6-luna", "effortLevel": "medium" },
      "factory:verifier": { "model": "gpt-6.1-sol", "effortLevel": "medium" }
    }
  },
  "inlineImages": false,
  "showReasoning": false,
  "footer": {
    "showModelEffort": true,
    "showDirectory": true,
    "showBranch": true,
    "showContextWindow": true,
    "showQuota": true,
    "showAiUsed": true,
    "showAgent": true,
    "showCodeChanges": true,
    "showUsername": false,
    "showSandbox": true,
    "showYolo": true,
    "showCiStatus": true,
    "showSchedules": false,
    "showPullRequest": true,
    "showCustom": true
  },
  "allowedUrls": [
    "https://docs.github.com",
    "https://learn.microsoft.com"
  ],
  "beep": true,
  "ide": {
    "autoConnect": false,
    "openDiffOnEdit": false
  }
}
