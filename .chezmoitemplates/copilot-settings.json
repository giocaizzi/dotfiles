{
  "extraKnownMarketplaces": {
    "giocaizzi-harness": {
      "source": {
        "source": "github",
        "repo": "giocaizzi/harness"
      }
    }
  },
  "enabledPlugins": {
    "python@giocaizzi-harness": true,
    "javascript@giocaizzi-harness": true,
    "api@giocaizzi-harness": true,
    "dev-tools@giocaizzi-harness": true,
    "guard@giocaizzi-harness": true,
    "hud@giocaizzi-harness": true
  },
  "statusLine": {
    "type": "command",
    "command": "node ~/.copilot/installed-plugins/giocaizzi-harness/hud/hooks/statusline.mjs"
  },
  "subagents": {
    "agents": {
      "dev-tools:scout": { "model": "gpt-6-luna", "effortLevel": "low" },
      "dev-tools:escalate": { "model": "gpt-6-astra", "effortLevel": "medium" }
    }
  },
  "inlineImages": false,
  "showReasoning": false,
  "footer": {
    "showModelEffort": true,
    "showDirectory": true,
    "showBranch": true,
    "showContextWindow": true,
    "showQuota": true,
    "showAiUsed": true,
    "showAgent": true,
    "showCodeChanges": true,
    "showUsername": false,
    "showSandbox": true,
    "showYolo": true,
    "showCiStatus": true,
    "showSchedules": false,
    "showPullRequest": true,
    "showCustom": true
  },
  "allowedUrls": [
    "https://docs.github.com",
    "https://learn.microsoft.com"
  ],
  "beep": true,
  "ide": {
    "autoConnect": false,
    "openDiffOnEdit": false
  }
}
