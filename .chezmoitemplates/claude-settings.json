{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"{{ if eq .chezmoi.os "windows" }},
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "3"{{ end }}{{ if and (not (get . "work")) (get . "otelEndpoint") }},
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_TRACES_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": {{ get . "otelEndpoint" | quote }},
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOG_TOOL_CONTENT": "0",
    "OTEL_RESOURCE_ATTRIBUTES": "service.namespace=claude-code,host.name={{ .chezmoi.hostname }},host.arch={{ .chezmoi.arch }},deployment.environment.name=production"{{ end }}
  },
  "cleanupPeriodDays": 365,
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash",
      "Bash(gh pr merge * --auto*)"
    ],
    "deny": [
      "Bash(gh pr merge * --admin*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/secrets/**)",
      "Read(~/.config/shell/secrets.sh)",
      "Read(~/.config/powershell/secrets.ps1)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.aws/credentials)",
      "Read(**/.aws/config)",
      "Read(**/.ssh/**)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/gcp-key*.json)",
      "Read(**/*.kubeconfig)",
      "Read(**/kubeconfig)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(**/secrets/**)",
      "Edit(~/.config/shell/secrets.sh)",
      "Edit(~/.config/powershell/secrets.ps1)",
      "Edit(**/.aws/credentials)",
      "Edit(**/.ssh/**)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(pipx:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(python -m pip:*)",
      "Bash(python3 -m pip:*)"{{ if eq .chezmoi.os "windows" }},
      "PowerShell(pipx *)",
      "PowerShell(pip *)",
      "PowerShell(pip3 *)",
      "PowerShell(python -m pip *)",
      "PowerShell(python3 -m pip *)"{{ end }}
    ],
    "ask": [
      "Bash(bw)",
      "Bash(bw *)"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "node {{ .chezmoi.homeDir }}/.claude/plugins/marketplaces/giocaizzi-harness/plugins/hud/hooks/statusline.mjs claude"
  },
  {{- if eq .chezmoi.os "windows" }}
  "defaultShell": "powershell",
  {{- end }}
  "disableClaudeAiConnectors": true,
  "enabledPlugins": {
    {{- range $p, $h := .harnessPlugins }}{{ if has "claude" $h }}
    "{{ $p }}@giocaizzi-harness": true,
    {{- end }}{{ end }}
    "next-steps@claude-community": false,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "giocaizzi-harness": {
      "source": {
        "source": "github",
        "repo": "giocaizzi/harness"
      },
      "autoUpdate": true
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      },
      "autoUpdate": true
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      },
      "autoUpdate": true
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "effortLevel": "medium",
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h",
  "autoCompactWindow": 500000,
  "tui": "fullscreen",
  "terminalProgressBarEnabled": true,
  "preferredNotifChannel": "terminal_bell",
  "showThinkingSummaries": true,
  "viewMode": "focus",
  "showTurnDuration": true,
  "terminalTitleFromRename": true,
  "timeFormat": "24h",
  "outputStyle": "Concise",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "askUserQuestionTimeout": "60s"
}
