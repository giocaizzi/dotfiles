{{- /* JSON list of {key, value} secrets from this machine's Bitwarden Secrets
       Manager project. Used by the secrets.sh / secrets.ps1 templates.
       --color no: bws colours JSON when FORCE_COLOR is set, even if piped. */ -}}
{{- $bws := joinPath .chezmoi.homeDir ".local" "bin" (ternary "bws.exe" "bws" (eq .chezmoi.os "windows")) -}}
{{- output $bws "secret" "list" .bwsProjectId "--access-token" .bwsAccessToken "--output" "json" "--color" "no" -}}
