{{- /* JSON list of {key, value} secrets from this machine's Bitwarden Secrets
       Manager project. Used by the secrets.sh / secrets.ps1 templates.
       --color no: bws colours JSON when FORCE_COLOR is set, even if piped.
       The token never goes on a command line (chezmoi echoes it in errors):
       the child process reads it from chezmoi's data and hands it to bws via
       BWS_ACCESS_TOKEN. The backtick string is the nested chezmoi's template. */ -}}
{{- $bws := joinPath .chezmoi.homeDir ".local" "bin" (ternary "bws.exe" "bws" (eq .chezmoi.os "windows")) -}}
{{- $token := `{{ .bwsAccessToken }}` -}}
{{- if eq .chezmoi.os "windows" -}}
{{- output "powershell" "-NoProfile" "-Command" (printf "$env:BWS_ACCESS_TOKEN = chezmoi execute-template '%s'; & '%s' secret list %s --output json --color no; exit $LASTEXITCODE" $token $bws .bwsProjectId) -}}
{{- else -}}
{{- output "sh" "-c" (printf "BWS_ACCESS_TOKEN=$(chezmoi execute-template '%s') exec '%s' secret list %s --output json --color no" $token $bws .bwsProjectId) -}}
{{- end -}}
