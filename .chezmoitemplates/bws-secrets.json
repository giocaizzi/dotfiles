{{- /* JSON list of {key, value} secrets from this machine's Bitwarden Secrets
       Manager project. Used by the secrets.sh / secrets.ps1 templates.
       --color no: bws colours JSON when FORCE_COLOR is set, even if piped.
       The token lives in the OS keyring and never goes on a command line (chezmoi
       echoes it in errors): the child process reads it with `chezmoi secret
       keyring get` and hands it to bws via BWS_ACCESS_TOKEN. No double quotes in
       the child command: Windows PowerShell 5.1 strips them. */ -}}
{{- $bws := joinPath .chezmoi.homeDir ".local" "bin" (ternary "bws.exe" "bws" (eq .chezmoi.os "windows")) -}}
{{- if eq .chezmoi.os "windows" -}}
{{- output "powershell" "-NoProfile" "-Command" (printf "$env:BWS_ACCESS_TOKEN = chezmoi secret keyring get --service=bws --user=access-token; & '%s' secret list %s --output json --color no; exit $LASTEXITCODE" $bws .bwsProjectId) -}}
{{- else -}}
{{- output "sh" "-c" (printf "BWS_ACCESS_TOKEN=$(chezmoi secret keyring get --service=bws --user=access-token) exec '%s' secret list %s --output json --color no" $bws .bwsProjectId) -}}
{{- end -}}
