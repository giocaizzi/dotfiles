# ============================================================================
# POSIX SHELL CONFIGURATION (Core)
# ============================================================================
# Shared between bash and zsh. POSIX-compliant — no bash/zsh-specific syntax.
# Aliases live in ~/.config/shell/aliases.sh; FZF config in ~/.config/shell/fzf.sh.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. ENVIRONMENT
# ----------------------------------------------------------------------------

# XDG Base Directory spec (explicit, so tools also honor it on macOS)
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"

# Load secrets (untracked, user-managed)
if [ -f "$XDG_CONFIG_HOME/shell/secrets.sh" ]; then
	. "$XDG_CONFIG_HOME/shell/secrets.sh"
fi

export EDITOR='vim'
export VISUAL='vim'

# Oh-My-Posh theme (single source for all shells)
export POSH_THEME="$XDG_CONFIG_HOME/oh-my-posh/theme.omp.json"

# ----------------------------------------------------------------------------
# 2. PATH
# ----------------------------------------------------------------------------

# Homebrew (macOS - Intel and Apple Silicon)
if [ -f /opt/homebrew/bin/brew ]; then
	eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -f /usr/local/bin/brew ]; then
	eval "$(/usr/local/bin/brew shellenv)"
fi

# Homebrew PostgreSQL (keg-only formulas need explicit PATH)
if [ -n "$HOMEBREW_PREFIX" ]; then
	for pg_formula in postgresql@17 postgresql@16 postgresql@15 postgresql; do
		if [ -d "$HOMEBREW_PREFIX/opt/$pg_formula/bin" ]; then
			export PATH="$HOMEBREW_PREFIX/opt/$pg_formula/bin:$PATH"
			break
		fi
	done
fi

# XDG user executables: uv (Linux), uv-managed Python, uv tools, claude
export PATH="$HOME/.local/bin:$PATH"

# User binaries
if [ -d "$HOME/bin" ]; then
	export PATH="$HOME/bin:$PATH"
fi

# Android SDK (macOS path; guard for portability)
if [ -d "$HOME/Library/Android/sdk" ]; then
	export ANDROID_HOME="$HOME/Library/Android/sdk"
	export PATH="$PATH:$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools"
fi

# Java 21 for Android/Gradle (macOS java_home helper)
if [ -x /usr/libexec/java_home ] && _jh=$(/usr/libexec/java_home -v 21 2>/dev/null); then
	export JAVA_HOME="$_jh"
fi
unset _jh

# Maestro (if installed)
if [ -d "$HOME/.maestro/bin" ]; then
	export PATH="$PATH:$HOME/.maestro/bin"
fi

# ----------------------------------------------------------------------------
# 3. SHARED SNIPPETS
# ----------------------------------------------------------------------------

# Aliases (rendered from .chezmoidata/shortcuts.toml)
[ -f "$XDG_CONFIG_HOME/shell/aliases.sh" ] && . "$XDG_CONFIG_HOME/shell/aliases.sh"

# FZF defaults (key bindings loaded by .bashrc / .zshrc)
[ -f "$XDG_CONFIG_HOME/shell/fzf.sh" ] && . "$XDG_CONFIG_HOME/shell/fzf.sh"

# ----------------------------------------------------------------------------
# End of .profile
# ----------------------------------------------------------------------------
