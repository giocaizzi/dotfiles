# ============================================================================
# .chezmoiexternal.toml.tmpl — declarative external sources
# ============================================================================
# Drop-in-place upstream sources (vim/zsh plugins, themes) fetched by chezmoi
# on `apply`, refreshed per `refreshPeriod`. Prefer this over a `git clone` in
# .chezmoiscripts/ when the upstream is "just put this repo at this path" —
# no build, no PATH wiring, no OS registration.
#
# Use install scripts for: tools needing a build step, PATH/registry setup, or
# package-manager registration. Use symlinks for: canonical per-OS configs.
#
# Reference: https://chezmoi.io/reference/special-files-and-directories/chezmoiexternal-format/
# ============================================================================

# Catppuccin colorscheme for Vim — native vim8+ pack plugin.
# `:colorscheme catppuccin_mocha` in dot_config/vim/vimrc activates it.
{{- if eq .chezmoi.os "windows" }}
["vimfiles/pack/catppuccin/start/catppuccin"]
{{- else }}
[".config/vim/pack/catppuccin/start/catppuccin"]
{{- end }}
    type = "git-repo"
    url = "https://github.com/catppuccin/vim.git"
    refreshPeriod = "168h"
    clone.args = ["--depth", "1"]
    pull.args = ["--ff-only"]

# JetBrainsMono Nerd Font — Linux only (macOS: Homebrew cask, Windows: oh-my-posh user-scope install,
# both in the install scripts). ~/.local/share/fonts is the XDG user font dir
# fontconfig scans natively.
# Not on light machines: .chezmoiignore doesn't stop an external's download.
{{- if and (eq .chezmoi.os "linux") (not (get . "light")) }}
[".local/share/fonts/JetBrainsMonoNerdFont"]
    type = "archive"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.tar.xz"
    include = ["*.ttf"]
    exact = true
    refreshPeriod = "168h"
{{- end }}

# Bitwarden Secrets Manager CLI (bws) — full machines only; renders the env
# secrets files (see docs/OS.md → Bitwarden). Into ~/.local/bin without sudo
# (Bitwarden's install script prefers sudo → /usr/local/bin).
{{- if not (get . "light") }}
{{- $arch := get (dict "amd64" "x86_64" "arm64" "aarch64") .chezmoi.arch }}
{{- $target := get (dict "darwin" "apple-darwin" "linux" "unknown-linux-gnu" "windows" "pc-windows-msvc") .chezmoi.os }}
{{- $exe := ternary "bws.exe" "bws" (eq .chezmoi.os "windows") }}
[".local/bin/{{ $exe }}"]
    type = "archive-file"
    url = "https://github.com/bitwarden/sdk-sm/releases/download/bws-v{{ .bws.version }}/bws-{{ $arch }}-{{ $target }}-{{ .bws.version }}.zip"
    path = "{{ $exe }}"
    executable = true
{{- end }}

# Oh My Zsh — macOS only (zsh is the macOS default shell; Linux uses bash,
# Windows uses PowerShell — both ignored in .chezmoiignore).
# dot_zshrc sources `$HOME/.oh-my-zsh/oh-my-zsh.sh`.
{{- if eq .chezmoi.os "darwin" }}
[".oh-my-zsh"]
    type = "git-repo"
    url = "https://github.com/ohmyzsh/ohmyzsh.git"
    refreshPeriod = "168h"
    clone.args = ["--depth", "1"]
    pull.args = ["--ff-only"]
{{- end }}
