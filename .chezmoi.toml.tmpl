{{- $user := promptStringOnce . "gitUser" "Git user name (text) — your name, used for every commit" -}}
{{- $email := promptStringOnce . "gitEmail" "PERSONAL git email (text) — default on personal machines; on a work machine only for personal repos" -}}
{{- $light := promptBoolOnce . "light" "Light install (yes/no) — shell, git, vim, prompt only" -}}
{{- /* Work machine: work git identity, no personal telemetry. Values stay in
       this machine's local config only (never committed). */ -}}
{{- $work := promptBoolOnce . "work" "Work computer (yes/no) — work git identity, no personal telemetry" -}}
{{- $workEmail := "" -}}
{{- $githubUser := "" -}}
{{- $personalGitRemote := "" -}}
{{- if $work }}
{{- $workEmail = promptStringOnce . "workEmail" "WORK git email (text) — default for every repo on this work machine" -}}
{{- $githubUser = promptStringOnce . "githubUser" "PERSONAL GitHub username (text, blank = none) — its github.com repos use the personal email, all others the work email" -}}
{{- $personalGitRemote = promptStringOnce . "personalGitRemote" "EXTRA personal remote URL globs (comma-separated text, blank = none) — other personal orgs or hosts; * stays within one path segment, so end with /** or :*/**, e.g. https://git.example.com/**,git@git.example.com:*/**" -}}
{{- end }}
{{- /* Bitwarden Secrets Manager: one machine-account token per machine, scoped to
       one project (personal or work); renders the env secrets files. */ -}}
{{- $bwsToken := "" -}}
{{- $bwsProject := "" -}}
{{- if not $light }}
{{- $bwsToken = promptStringOnce . "bwsAccessToken" "Bitwarden Secrets Manager access token (text, blank = secrets file by hand) — this machine's token, visible while typed" -}}
{{- if $bwsToken }}{{ $bwsProject = promptStringOnce . "bwsProjectId" "Bitwarden Secrets Manager project ID (text) — the project this token can read" }}{{ end -}}
{{- end }}

# Secrets (e.g. ~/.ssh/config) are committed age-encrypted. The private key
# lives only at ~/.config/chezmoi/key.txt on each machine (copied by hand);
# the recipient below is the matching public key and is safe to publish.
encryption = "age"

[age]
    identity = "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
    recipient = "age103kslutkh98kkzp95evpt89qgjlp2ndl2qglw9ueze6r5g2hvy6sj4xj25"

[data]
    gitUser = {{ $user | quote }}
    gitEmail = {{ $email | quote }}
    light = {{ $light }}
    work = {{ $work }}
    workEmail = {{ $workEmail | quote }}
    githubUser = {{ $githubUser | quote }}
    personalGitRemote = {{ $personalGitRemote | quote }}
    bwsAccessToken = {{ $bwsToken | quote }}
    bwsProjectId = {{ $bwsProject | quote }}

[git]
    autoAdd = true
    autoCommit = true
    autoPush = true
    # Conventional Commit messages (chore: add/update/remove …)
    commitMessageTemplateFile = ".commit-message.tmpl"

# Configures `chezmoi merge`: the 3-way merge tool used to reconcile drift
# between source (chezmoi), target (rendered) and destination (home) files.
# Unrelated to git's merge configuration.
[merge]
{{- if eq .chezmoi.os "windows" }}
    command = "vim"
    args = [
        "-d",
        {{ printf "%q" "{{ .Destination }}" }},
        {{ printf "%q" "{{ .Source }}" }},
        {{ printf "%q" "{{ .Target }}" }},
    ]
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
    command = "vimdiff"
    args = [
        {{ printf "%q" "{{ .Destination }}" }},
        {{ printf "%q" "{{ .Source }}" }},
        {{ printf "%q" "{{ .Target }}" }},
    ]
{{- end }}
    
