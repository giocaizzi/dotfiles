{{- $user := promptStringOnce . "gitUser" "User name" -}}
{{- $email := promptStringOnce . "gitEmail" "Email address" -}}
{{- $light := promptBoolOnce . "light" "Light install (shell, git, vim, prompt only)" -}}
{{- /* Work machine: work git identity, no personal telemetry. Values stay in
       this machine's local config only (never committed). */ -}}
{{- $work := promptBoolOnce . "work" "Work computer (work git identity, no personal telemetry)" -}}
{{- $workGitDir := "" -}}
{{- $workGitRemote := "" -}}
{{- $workEmail := "" -}}
{{- $workSshKey := "" -}}
{{- if $work }}
{{- $workGitDir = promptStringOnce . "workGitDir" "Work repos folder, e.g. ~/work (blank for none)" -}}
{{- $workGitRemote = promptStringOnce . "workGitRemote" "Work remote URL globs, comma-separated; * stays within one path segment, so end with /** or :*/**, e.g. https://git.example.com/**,git@git.example.com:*/** (blank for none)" -}}
{{- $workEmail = promptStringOnce . "workEmail" "Work git email" -}}
{{- $workSshKey = promptStringOnce . "workSshKey" "Work SSH key for repos in the work folder, e.g. ~/.ssh/id_ed25519_work (blank for none)" -}}
{{- end }}
{{- /* Bitwarden Secrets Manager: one machine-account token per machine, scoped to
       one project (personal or work); renders the env secrets files. */ -}}
{{- $bwsToken := "" -}}
{{- $bwsProject := "" -}}
{{- if not $light }}
{{- $bwsToken = promptStringOnce . "bwsAccessToken" "Bitwarden Secrets Manager access token for this machine (blank = secrets file by hand)" -}}
{{- if $bwsToken }}{{ $bwsProject = promptStringOnce . "bwsProjectId" "Bitwarden Secrets Manager project ID" }}{{ end -}}
{{- end }}

# Secrets (e.g. ~/.ssh/config) are committed age-encrypted. The private key
# lives only at ~/.config/chezmoi/key.txt on each machine (copied by hand);
# the recipient below is the matching public key and is safe to publish.
encryption = "age"

[age]
    identity = "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
    recipient = "age103kslutkh98kkzp95evpt89qgjlp2ndl2qglw9ueze6r5g2hvy6sj4xj25"

[data]
    gitUser = {{ $user | quote }}
    gitEmail = {{ $email | quote }}
    light = {{ $light }}
    work = {{ $work }}
    workGitDir = {{ $workGitDir | quote }}
    workGitRemote = {{ $workGitRemote | quote }}
    workEmail = {{ $workEmail | quote }}
    workSshKey = {{ $workSshKey | quote }}
    bwsAccessToken = {{ $bwsToken | quote }}
    bwsProjectId = {{ $bwsProject | quote }}

[git]
    autoAdd = true
    autoCommit = true
    autoPush = true
    # Conventional Commit messages (chore: add/update/remove …)
    commitMessageTemplateFile = ".commit-message.tmpl"

# Configures `chezmoi merge`: the 3-way merge tool used to reconcile drift
# between source (chezmoi), target (rendered) and destination (home) files.
# Unrelated to git's merge configuration.
[merge]
{{- if eq .chezmoi.os "windows" }}
    command = "vim"
    args = [
        "-d",
        {{ printf "%q" "{{ .Destination }}" }},
        {{ printf "%q" "{{ .Source }}" }},
        {{ printf "%q" "{{ .Target }}" }},
    ]
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
    command = "vimdiff"
    args = [
        {{ printf "%q" "{{ .Destination }}" }},
        {{ printf "%q" "{{ .Source }}" }},
        {{ printf "%q" "{{ .Target }}" }},
    ]
{{- end }}
    
