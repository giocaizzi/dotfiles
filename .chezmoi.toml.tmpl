{{- $user := promptStringOnce . "gitUser" "[ GIT IDENTITY ] Name — used for every commit" -}}
{{- $email := promptStringOnce . "gitEmail" "[ PERSONAL EMAIL ] Email — default on personal machines; on work machines, used only for personal repos" -}}
{{- $light := promptBoolOnce . "light" "[ INSTALL MODE ] Light setup? (yes/no — shell, git, vim, and prompt only)" -}}
{{- /* Work machine: work git identity, no personal telemetry. Values stay in
       this machine's local config only (never committed). */ -}}
{{- $work := promptBoolOnce . "work" "[ MACHINE ROLE ] Work computer? (yes/no — work git identity, no personal telemetry)" -}}
{{- $workEmail := "" -}}
{{- $githubUser := "" -}}
{{- $personalGitRemote := "" -}}
{{- if $work }}
{{- $workEmail = promptStringOnce . "workEmail" "[ WORK EMAIL ] Email — default for every repo on this work machine" -}}
{{- $githubUser = promptStringOnce . "githubUser" "[ PERSONAL GITHUB ] Username (blank = none) — github.com repos use your personal email; all others use the work email" -}}
{{- $personalGitRemote = promptStringOnce . "personalGitRemote" "[ PERSONAL REMOTES ] Extra URL globs, comma-separated (blank = none) — * matches one path segment; end with /** or :*/**; e.g. https://git.example.com/**,git@git.example.com:*/**" -}}
{{- end }}
{{- /* Bitwarden Secrets Manager: one machine-account token per machine, scoped to
       one project (personal or work); renders the env secrets files. The token
       itself lives in the OS keyring (service "bws", user "access-token"), never
       in this file; the project ID is the on/off switch. */ -}}
{{- $bwsProject := "" -}}
{{- if not $light }}
{{- $bwsProject = promptStringOnce . "bwsProjectId" "[ SECRETS / BWS ] Project ID (blank = configure secrets file by hand) — store the token first: chezmoi secret keyring set --service=bws --user=access-token" -}}
{{- end }}

# Secrets (e.g. ~/.ssh/config) are committed age-encrypted. The private key
# lives only at ~/.config/chezmoi/key.txt on each machine (copied by hand);
# the recipient below is the matching public key and is safe to publish.
encryption = "age"

[age]
    identity = "{{ .chezmoi.homeDir }}/.config/chezmoi/key.txt"
    recipient = "age103kslutkh98kkzp95evpt89qgjlp2ndl2qglw9ueze6r5g2hvy6sj4xj25"

[data]
    gitUser = {{ $user | quote }}
    gitEmail = {{ $email | quote }}
    light = {{ $light }}
    work = {{ $work }}
    workEmail = {{ $workEmail | quote }}
    githubUser = {{ $githubUser | quote }}
    personalGitRemote = {{ $personalGitRemote | quote }}
    bwsProjectId = {{ $bwsProject | quote }}

[git]
    autoAdd = true
    autoCommit = true
    autoPush = true
    # Conventional Commit messages (chore: add/update/remove …)
    commitMessageTemplateFile = ".commit-message.tmpl"

# Configures `chezmoi merge`: the 3-way merge tool used to reconcile drift
# between source (chezmoi), target (rendered) and destination (home) files.
# Unrelated to git's merge configuration.
[merge]
{{- if eq .chezmoi.os "windows" }}
    command = "vim"
    args = [
        "-d",
        {{ printf "%q" "{{ .Destination }}" }},
        {{ printf "%q" "{{ .Source }}" }},
        {{ printf "%q" "{{ .Target }}" }},
    ]
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
    command = "vimdiff"
    args = [
        {{ printf "%q" "{{ .Destination }}" }},
        {{ printf "%q" "{{ .Source }}" }},
        {{ printf "%q" "{{ .Target }}" }},
    ]
{{- end }}
    
