#!/usr/bin/env bash
set -e

# ============================================================================
# CONFIGURATION
# ============================================================================

VERBOSE=true  # Set to false for minimal output
PYTHON_VERSION="3.13"  # global python/python3, installed by uv

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

# ============================================================================
# PACKAGE DEFINITIONS (Single Source of Truth)
# ============================================================================

# Core packages for ALL platforms
CORE_PACKAGES=(
	"fzf"           # Fuzzy finder
	"git"           # Version control
	"vim"           # Text editor
	"fd"            # Modern find alternative
	"gh"            # GitHub CLI
	"tmux"          # Terminal multiplexer
)

# Shell-specific packages (macOS uses zsh, Linux uses bash)
SHELL_PACKAGES_MACOS=(
	"zsh-autosuggestions"
)

# Fonts (Homebrew casks; Linux gets the same font via .chezmoiexternal.toml.tmpl)
FONTS_MACOS=(
	"font-jetbrains-mono-nerd-font"
)

# Bitwarden vault CLI (bw): personal full machines only, used to fetch the
# chezmoi age key. bws comes from .chezmoiexternal.toml.tmpl.
{{- if not (or (get . "light") (get . "work")) }}
BITWARDEN_MACOS=("bitwarden-cli")
{{- else }}
BITWARDEN_MACOS=()
{{- end }}

SHELL_PACKAGES_LINUX=(
	"bash-completion"
)

# Additional tools (cross-platform, custom installation)
ADDITIONAL_TOOLS=(
	"uv"            # Python versions + CLI tools
	"oh-my-posh"
)

{{- if get . "light" }}

# Light machines: core tools + the prompt only
CORE_PACKAGES=("fzf" "git" "vim" "fd" "tmux")
SHELL_PACKAGES_MACOS=()
SHELL_PACKAGES_LINUX=()
FONTS_MACOS=()
ADDITIONAL_TOOLS=("oh-my-posh")
{{- end }}

# ============================================================================
# PACKAGE NAME MAPPING (apt names differ from Homebrew)
# ============================================================================

map_package_name() {
	local pkg=$1
	case "$pkg" in
		"fd") echo "fd-find" ;;  # fd is fd-find on Debian/Ubuntu
		*) echo "$pkg" ;;
	esac
}

# ============================================================================
# TOOL INSTALLATION FUNCTIONS
# ============================================================================

install_tool_macos() {
	local tool=$1
	if command -v "$tool" >/dev/null 2>&1; then
		[ "$VERBOSE" = true ] && echo -e "${GREEN}✓${NC} $tool already installed"
	else
		echo -e "${BLUE}Installing${NC} $tool..."
		brew install "$tool"
	fi
}

install_tool_linux() {
	local tool=$1
	if command -v "$tool" >/dev/null 2>&1; then
		[ "$VERBOSE" = true ] && echo -e "${GREEN}✓${NC} $tool already installed"
		return
	fi
	
	echo -e "${BLUE}Installing${NC} $tool..."
	case "$tool" in
		"uv")
			# Official installer → ~/.local/bin; UV_NO_MODIFY_PATH keeps it out
			# of the chezmoi-managed rc files (~/.profile already has the PATH).
			curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh
			;;
		"oh-my-posh")
			# -d: default would be ~/bin if it exists; keep user binaries in ~/.local/bin
			curl -s https://ohmyposh.dev/install.sh | bash -s -- -d "$HOME/.local/bin"
			;;
		*)
			echo "Warning: No installation method for $tool" >&2
			;;
	esac
}

# Global python/python3 via uv. --default is a uv preview feature; opting in
# explicitly silences its warning.
# Skipped where uv isn't installed (light machines).
install_python() {
	local uv
	uv="$(command -v uv || echo "$HOME/.local/bin/uv")"
	[ -x "$uv" ] || return 0
	[ "$VERBOSE" = true ] && echo -e "\n${YELLOW}Python ${PYTHON_VERSION} (uv):${NC}"
	"$uv" python install "$PYTHON_VERSION" --default --preview-features python-install-default
}

# ============================================================================
# INSTALLATION
# ============================================================================

{{- if eq .chezmoi.os "darwin" }}
# macOS: Use Homebrew
echo -e "${BLUE}Installing required packages...${NC}"

if ! command -v brew >/dev/null 2>&1; then
	echo "Homebrew is required but not installed" >&2
	echo "Install it from: https://brew.sh" >&2
	exit 1
fi

# Install packages via Homebrew
ALL_BREW_PACKAGES=("${CORE_PACKAGES[@]}" "${SHELL_PACKAGES_MACOS[@]}" "${FONTS_MACOS[@]}" "${BITWARDEN_MACOS[@]}")

if [ "$VERBOSE" = true ]; then
	echo -e "\n${YELLOW}Installing packages via Homebrew:${NC}"
fi

for pkg in "${ALL_BREW_PACKAGES[@]}"; do
	if brew list "$pkg" >/dev/null 2>&1; then
		[ "$VERBOSE" = true ] && echo -e "${GREEN}✓${NC} $pkg already installed"
	else
		echo -e "${BLUE}Installing${NC} $pkg..."
		brew install "$pkg"
	fi
done

# Additional tools
if [ "$VERBOSE" = true ]; then
	echo -e "\n${YELLOW}Additional tools:${NC}"
fi

for tool in "${ADDITIONAL_TOOLS[@]}"; do
	install_tool_macos "$tool"
done

install_python

# Oh My Zsh is fetched declaratively via .chezmoiexternal.toml.tmpl.
{{- end }}

{{- if eq .chezmoi.os "linux" }}
# Linux: Use apt-get (bash only, no zsh)
echo -e "${BLUE}Installing required packages...${NC}"

# Install GitHub CLI repo (gh requires special setup)
if ! command -v gh >/dev/null 2>&1; then
	[ "$VERBOSE" = true ] && echo -e "${YELLOW}Adding GitHub CLI repository...${NC}"
	(type -p wget >/dev/null || (sudo apt-get update && sudo apt-get install wget -y)) \
		&& sudo mkdir -p -m 755 /etc/apt/keyrings \
		&& wget -qO- https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg > /dev/null \
		&& sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
		&& echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
fi

# Build package list with apt name mapping
ALL_APT_PACKAGES=("${CORE_PACKAGES[@]}" "${SHELL_PACKAGES_LINUX[@]}")
APT_PKGS=("curl" "python3-pip")  # Additional dependencies
for pkg in "${ALL_APT_PACKAGES[@]}"; do
	APT_PKGS+=("$(map_package_name "$pkg")")
done

if [ "$VERBOSE" = true ]; then
	echo -e "\n${YELLOW}Installing packages via apt:${NC}"
fi
sudo apt-get update
sudo apt-get install -y "${APT_PKGS[@]}"

# Additional tools
if [ "$VERBOSE" = true ]; then
	echo -e "\n${YELLOW}Additional tools:${NC}"
fi

for tool in "${ADDITIONAL_TOOLS[@]}"; do
	install_tool_linux "$tool"
done

install_python

# Create fd symlink (fd-find -> fd) for consistency with macOS
if command -v fdfind >/dev/null 2>&1 && ! command -v fd >/dev/null 2>&1; then
	[ "$VERBOSE" = true ] && echo -e "${BLUE}Creating${NC} fd symlink..."
	mkdir -p "$HOME/.local/bin"
	ln -sf "$(which fdfind)" "$HOME/.local/bin/fd"
fi

echo -e "\n${GREEN}✓ All packages installed successfully${NC}"
{{- end }}