{{- /* chezmoi:modify-template */ -}}
{{- /* User-scope MCP servers (.chezmoidata/mcp.toml, .chezmoitemplates/mcp-user.json) merged into
       pi's file; servers added with `pi mcp add` stay. */ -}}
{{- $current := dict -}}
{{- if .chezmoi.stdin }}{{ $current = fromJson .chezmoi.stdin }}{{ end -}}
{{- $servers := get $current "mcpServers" | default dict -}}
{{- range $n, $u := includeTemplate "mcp-servers.json" (includeTemplate "mcp-user.json" . | fromJson) | fromJson }}{{ $_ := set $servers $n (dict "url" $u) }}{{ end -}}
{{- $_ := set $current "mcpServers" $servers -}}
{{- $current | toPrettyJson }}
