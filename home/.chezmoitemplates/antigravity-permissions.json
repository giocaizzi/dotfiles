{{- $p := .harnessPolicy.permissions -}}
{{- $deny := list -}}
{{- range $p.denyCommandPatterns }}{{ $deny = append $deny (printf "command(%s)" .) }}{{ end -}}
{{- range $p.denyCommandExact }}{{ $deny = append $deny (printf "command(%s)" .) }}{{ end -}}
{{- range $p.denyCommandPrefixes -}}
{{- if not (contains " " .) }}{{ $deny = append $deny (printf "command(%s)" .) }}{{ end -}}
{{- $deny = append $deny (printf "command(%s *)" .) -}}
{{- end -}}
{{- range $p.denyRead }}{{ $deny = append $deny (printf "read_file(%s)" .) }}{{ end -}}
{{- range $p.denyWrite }}{{ $deny = append $deny (printf "write_file(%s)" .) }}{{ end -}}
{{- $ask := list -}}
{{- range $p.askCommandPrefixes }}{{ $ask = append $ask (printf "command(%s)" .) }}{{ $ask = append $ask (printf "command(%s *)" .) }}{{ end -}}
{{- dict "allow" (list "command(*)" "command(gh pr merge * --auto*)" "read_url(*)" "execute_url(*)" "mcp(*)") "deny" $deny "ask" $ask | toJson -}}
