{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"{{ if eq .chezmoi.os "windows" }},
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "3"{{ end }}{{ if and (not (get . "work")) (get . "otelEndpoint") }},
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "CLAUDE_CODE_ENHANCED_TELEMETRY_BETA": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_TRACES_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": {{ get . "otelEndpoint" | quote }},
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "cumulative",
    "OTEL_LOG_TOOL_DETAILS": "1",
    "OTEL_LOG_TOOL_CONTENT": "0",
    "OTEL_RESOURCE_ATTRIBUTES": "service.namespace=claude-code,host.name={{ .chezmoi.hostname }},host.arch={{ .chezmoi.arch }},deployment.environment.name=production"{{ end }}
  },
  "cleanupPeriodDays": 365,
  "permissions": {{ includeTemplate "claude-permissions.json" . }},
  "statusLine": {
    "type": "command",
    "command": "node {{ .chezmoi.homeDir }}/.claude/plugins/marketplaces/giocaizzi-harness/plugins/hud/hooks/statusline.mjs claude"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "node {{ .chezmoi.homeDir }}/.claude/plugins/marketplaces/giocaizzi-harness/plugins/hud/hooks/statusline.mjs subagent"
  },
  {{- if eq .chezmoi.os "windows" }}
  "defaultShell": "powershell",
  {{- end }}
  "disableClaudeAiConnectors": true,
  "enabledPlugins": {
    {{- range $p, $h := .harnessPlugins }}{{ if has "claude" $h }}
    "{{ $p }}@giocaizzi-harness": {{ (not (and (get $ "work") (has $p $.harnessPersonalPlugins))) }},
    {{- end }}{{ end }}
    "next-steps@claude-community": false,
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true{{ if and (ne .chezmoi.os "windows") (not (get . "work")) }},
    "gopls-lsp@claude-plugins-official": true
    {{- end }}
  },
  "extraKnownMarketplaces": {
    "giocaizzi-harness": {
      "source": {
        "source": "github",
        "repo": "giocaizzi/harness"
      },
      "autoUpdate": true
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      },
      "autoUpdate": true
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      },
      "autoUpdate": true
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "effortLevel": "medium",
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h",
  "autoCompactWindow": 500000,
  "tui": "fullscreen",
  "terminalProgressBarEnabled": true,
  "preferredNotifChannel": {{ ternary "terminal_bell" "notifications_disabled" .harnessPolicy.notifications.terminalBell | quote }},
  "showThinkingSummaries": true,
  "viewMode": "focus",
  "showTurnDuration": true,
  "terminalTitleFromRename": true,
  "timeFormat": "24h",
  "outputStyle": "Concise",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": {{ .harnessPolicy.native.claude.skipAutoPermissionPrompt | toJson }},
  "askUserQuestionTimeout": "60s"
}
