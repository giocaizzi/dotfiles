{
  "agentMode": "auto",
  "toolPermission": "always-proceed",
  "enableTerminalSandbox": false,
  "allowNonWorkspaceAccess": true,
  "permissions": {
    "allow": [
      "command(*)",
      "command(gh pr merge * --auto*)",
      "read_url(*)",
      "execute_url(*)",
      "mcp(*)"
    ],
    "deny": [
      "command(gh pr merge * --admin*)",
      "command(env)",
      "command(printenv)",
      "command(printenv *)",
      "command(pipx)",
      "command(pipx *)",
      "command(pip)",
      "command(pip *)",
      "command(pip3)",
      "command(pip3 *)",
      "command(python -m pip *)",
      "command(python3 -m pip *)",
      "read_file(**/.env)",
      "read_file(**/.env.local)",
      "read_file(**/.env.*.local)",
      "read_file(**/.env.development)",
      "read_file(**/.env.production)",
      "read_file(**/.env.staging)",
      "read_file(**/.env.test)",
      "read_file(**/secrets/**)",
      "read_file(~/.config/shell/secrets.sh)",
      "read_file(~/.config/powershell/secrets.ps1)",
      "read_file(**/*.pem)",
      "read_file(**/*.key)",
      "read_file(**/*.p12)",
      "read_file(**/*.pfx)",
      "read_file(**/id_rsa*)",
      "read_file(**/id_ed25519*)",
      "read_file(**/.aws/credentials)",
      "read_file(**/.aws/config)",
      "read_file(**/.ssh/**)",
      "read_file(**/.netrc)",
      "read_file(**/.npmrc)",
      "read_file(**/.pypirc)",
      "read_file(**/credentials.json)",
      "read_file(**/service-account*.json)",
      "read_file(**/gcp-key*.json)",
      "read_file(**/*.kubeconfig)",
      "read_file(**/kubeconfig)",
      "write_file(**/.env)",
      "write_file(**/.env.local)",
      "write_file(**/.env.*.local)",
      "write_file(**/.env.development)",
      "write_file(**/.env.production)",
      "write_file(**/.env.staging)",
      "write_file(**/.env.test)",
      "write_file(**/secrets/**)",
      "write_file(~/.config/shell/secrets.sh)",
      "write_file(~/.config/powershell/secrets.ps1)",
      "write_file(**/.aws/credentials)",
      "write_file(**/.ssh/**)"
    ],
    "ask": [
      "command(bw)",
      "command(bw *)"
    ]
  }
}
