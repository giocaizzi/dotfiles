{{- /* JSON list of {key, value} secrets from this machine's Bitwarden Secrets
       Manager project. Used by the secrets.sh / secrets.ps1 templates.
       `chezmoi dots secrets run bws` ([secret.bws] in .chezmoidata/secrets.toml) reads
       the token from the OS keyring and hands it to bws only as BWS_ACCESS_TOKEN, never
       on a command line (chezmoi echoes failed commands). Each argument is passed as is,
       with no shell, so the call is the same on every OS. The plugin is called by its
       absolute path, since PATH may lack ~/.local/bin during apply; it finds this source
       and config through the CHEZMOI_* variables chezmoi sets. .chezmoiignore skips the
       secrets files until both binaries are installed.
       --color no: bws colours JSON when FORCE_COLOR is set, even if piped. */ -}}
{{- $dots := joinPath .chezmoi.homeDir ".local" "bin" (ternary "chezmoi-dots.exe" "chezmoi-dots" (eq .chezmoi.os "windows")) -}}
{{- output $dots "secrets" "run" "bws" "--" "secret" "list" .bwsProjectId "--output" "json" "--color" "no" -}}
