{{- /* dots-edit configuration matrix (docs/OS.md#editing-your-dotfiles): one line per OS x
  role, <os>/<role> TAB <--override-data JSON>. Every harness is selected (light machines
  have none), so every harness file is rendered; the list matches $all in
  .chezmoi.toml.tmpl. Identity answers this machine lacks render as <name> placeholders
  instead of blanks; the other answers default to blank (= feature off), as at init.
  No Bitwarden project: the secrets stay this machine's, and parallel renders would hit
  the Secrets Manager rate limit. make lint-edit checks the answers against [data] in
  .chezmoi.toml.tmpl. */ -}}
{{- $all := list "claude" "copilot" "vscode" "codex" "opencode" "pi" -}}
{{- $answers := dict -}}
{{- range list "gitUser" "gitEmail" "workEmail" }}{{ if not (get $ .) }}{{ $_ := set $answers . (printf "<%s>" .) }}{{ end }}{{ end -}}
{{- range list "githubUser" "personalGitRemote" "otelEndpoint" }}{{ if not (hasKey $ .) }}{{ $_ := set $answers . "" }}{{ end }}{{ end -}}
{{- $_ := set $answers "bwsProjectId" "" -}}
{{- range $os := list "darwin" "linux" "windows" }}{{ range $role := list "personal" "work" "light" -}}
{{-   $data := merge (dict "chezmoi" (dict "os" $os) "light" (eq $role "light") "work" (eq $role "work") "harnesses" (ternary (list) $all (eq $role "light"))) $answers -}}
{{    printf "%s/%s\t%s" $os $role (toJson $data) }}
{{ end }}{{ end -}}
