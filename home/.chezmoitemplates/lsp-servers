{{- /* Language servers for this machine ([harnessPolicy.lsp.server.*] in
  .chezmoidata/harness-policy.toml). Called as
    includeTemplate "lsp-servers" . | fromJson
  Returns {"<name>": {"command": [...], "extensions": {".ext": "languageId"}, "format": bool}}
  for each server whose package (.chezmoidata/packages.toml) installs here: selected for
  this machine's role and installed on this OS (uv and npm everywhere, brew and cask on
  macOS, apt on Linux, winget on Windows, script on the OSes it lists). Empty when
  harnessPolicy.lsp.enabled is false. */ -}}
{{- $os := .chezmoi.os -}}
{{- $role := includeTemplate "role" . -}}
{{- $lsp := .harnessPolicy.lsp | default dict -}}
{{- $out := dict -}}
{{- if get $lsp "enabled" -}}
{{-   range $name, $s := get $lsp "server" | default dict -}}
{{-     $p := get ($.package | default dict) $s.package | default dict -}}
{{-     $here := or (get $p "uv") (get $p "npm") -}}
{{-     if eq $os "darwin" }}{{ $here = or $here (get $p "brew") (get $p "cask") }}{{ end -}}
{{-     if eq $os "linux" }}{{ $here = or $here (get $p "apt") }}{{ end -}}
{{-     if eq $os "windows" }}{{ $here = or $here (get $p "winget") }}{{ end -}}
{{-     $here = or $here (has $os (get $p "script" | default list)) -}}
{{-     if and $p $here (has $role (get $p "roles" | default (list "personal" "work"))) -}}
{{-       $_ := set $out $name (dict "command" $s.command "extensions" $s.extensions "format" (get $s "format" | default false)) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $out | toJson -}}
