{
  "extraKnownMarketplaces": {
    "giocaizzi-harness": {
      "source": {
        "source": "github",
        "repo": "giocaizzi/harness"
      }
    }
  },
  "enabledPlugins": {{ $on := dict }}{{ range $p, $h := .harnessPlugins }}{{ if has "copilot" $h }}{{ $_ := set $on (printf "%s@giocaizzi-harness" $p) (not (and (get $ "work") (has $p $.harnessPersonalPlugins))) }}{{ end }}{{ end }}{{ $on | toJson }},
  "statusLine": {
    "type": "command",
    "command": "node ~/.copilot/installed-plugins/giocaizzi-harness/hud/hooks/statusline.mjs"
  },
  "subagents": { "agents": {{ .agents.native.copilot.agents | toJson }} },
  "inlineImages": false,
  "showReasoning": false,
  "theme": "default",
  "footer": {
    "showModelEffort": true,
    "showDirectory": true,
    "showBranch": true,
    "showContextWindow": true,
    "showQuota": true,
    "showAiUsed": true,
    "showAgent": true,
    "showCodeChanges": true,
    "showUsername": false,
    "showSandbox": true,
    "showYolo": true,
    "showCiStatus": true,
    "showSchedules": false,
    "showPullRequest": true,
    "showCustom": true
  },
  "allowedUrls": {{ .agents.permissions.allowedUrls | toJson }},
  "beep": {{ (or .agents.ui.terminalBell .agents.notifications.terminalBell) | toJson }},
  "voice": { "enabled": {{ .agents.voice.enabled | default false | toJson }} },
  "ide": {
    "autoConnect": false,
    "openDiffOnEdit": false
  }
}
