{{- /* chezmoi:modify-template */ -}}
{{- /* Managed keys (.chezmoitemplates/claude-settings.json) win; keys Claude Code
       writes itself (e.g. autoMode) are kept local and never committed. */ -}}
{{- $current := dict -}}
{{- if .chezmoi.stdin }}{{ $current = fromJson .chezmoi.stdin }}{{ end -}}
{{- /* Work machines send no telemetry to the personal OTel endpoint. The merge
       never deletes, so strip any telemetry keys already in the live file. */ -}}
{{- if and (get . "work") (hasKey $current "env") }}
{{- range $k, $v := $current.env }}
{{- if or (hasPrefix "OTEL_" $k) (contains "TELEMETRY" $k) }}{{ $x := unset $current.env $k }}{{ end }}
{{- end }}
{{- end }}
{{- $managed := includeTemplate "claude-settings.json" . | fromJson -}}
{{- /* Go maps sort keys, so toPrettyJson reorders the whole file on every apply.
       jq's `*` keeps the live file's key order (new keys append) and is the same
       deep merge; fall back to toPrettyJson where jq is absent. */ -}}
{{- if lookPath "jq" }}
{{- $strip := "" }}
{{- if get . "work" }}{{ $strip = `(if has("env") then .env |= with_entries(select(.key | (startswith("OTEL_") or contains("TELEMETRY")) | not)) else . end) | ` }}{{ end }}
{{- output "jq" "-n" "--argjson" "c" (.chezmoi.stdin | default "{}") "--argjson" "m" ($managed | toJson) (print "($c | " $strip "." ") * $m") | trimSuffix "\n" }}
{{- else }}
{{- mergeOverwrite $current $managed | toPrettyJson }}
{{- end }}
