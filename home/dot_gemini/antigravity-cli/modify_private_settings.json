{{- /* chezmoi:modify-template */ -}}
{{- /* Managed keys (.chezmoitemplates/antigravity-settings.json) win; keys
       Antigravity writes itself (e.g. model, trustedWorkspaces, statusLine) stay local. */ -}}
{{- $current := dict -}}
{{- if .chezmoi.stdin }}{{ $current = fromJson .chezmoi.stdin }}{{ end -}}
{{- $managed := includeTemplate "antigravity-settings.json" . | fromJson -}}
{{- if lookPath "jq" }}
{{- output "jq" "-n" "--argjson" "c" (.chezmoi.stdin | default "{}") "--argjson" "m" ($managed | toJson) "$c * $m" | trimSuffix "\n" }}
{{- else }}
{{- mergeOverwrite $current $managed | toPrettyJson }}
{{- end }}
