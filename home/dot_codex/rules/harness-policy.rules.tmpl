{{- /* Codex command rules from the shared policy (.chezmoidata/harness-policy.toml): the rules in
        ~/.codex/rules/ are merged, the most restrictive match wins (forbidden > prompt > allow). The TUI
        writes its own allow-list to default.rules, which is not managed. A pattern is an exact token
        prefix with no wildcards: a trailing " *" is dropped, a pattern with an inner `*` is skipped and
        patterns that collapse to the same prefix render once. Only the lease-push patterns are rendered
        for Codex; the other deny lists are not. */ -}}
{{- $p := .harnessPolicy.permissions -}}
{{- $seen := dict -}}
# Managed by chezmoi from harnessPolicy.permissions: do not edit.
{{ range $p.allowCommandPatterns }}{{ $t := trimSuffix " *" . }}{{ if not (contains "*" $t) -}}
prefix_rule(
    pattern = {{ splitList " " $t | toJson }},
    decision = "allow",
    justification = "Lease pushes are allowed to feature branches.",
    match = ["git push --force-with-lease origin feat/x"],
    not_match = ["git push --force origin feat/x"],
)
{{ end }}{{ end -}}
{{ range $p.denyCommandPatterns }}{{ if hasPrefix "git push " . }}{{ $t := trimSuffix " *" . }}{{ if not (or (contains "*" $t) (hasKey $seen $t)) -}}
{{ $_ := set $seen $t true -}}
prefix_rule(
    pattern = {{ splitList " " $t | toJson }},
    decision = "forbidden",
    justification = "Never push to main or master; open a pull request.",
    match = ["{{ $t }}"],
    not_match = ["git push --force-with-lease origin feat/x"],
)
{{ end }}{{ end }}{{ end -}}
