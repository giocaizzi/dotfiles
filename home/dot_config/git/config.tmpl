[user]
	name = {{ .gitUser }}
{{- if get . "work" }}
	email = {{ .workEmail }}
{{- else }}
	email = {{ .gitEmail }}
{{- end }}
{{- $owners := list }}
{{- $extra := list }}
{{- with get . "githubUser" }}{{ $owners = append $owners . }}{{ end }}
{{- range splitList "," (get . "personalGitRemote") }}{{ with trim . }}
{{- if regexMatch "^[A-Za-z0-9][A-Za-z0-9-]*$" . }}{{ $owners = append $owners . }}{{ else }}{{ $extra = append $extra . }}{{ end }}
{{- end }}{{ end }}
{{- $globs := list }}
{{- range $owners }}
{{- $globs = concat $globs (list (printf "git@github.com:%s/**" .) (printf "ssh://git@github.com/%s/**" .) (printf "https://github.com/%s/**" .) (printf "https://*@github.com/%s/**" .)) }}
{{- end }}
{{- $globs = concat $globs $extra }}
{{- if $globs }}

# Work machine: the work email is the default; repos with a matching remote
# URL (the personal GitHub user, extra github.com orgs and any extra globs) use the personal email
# (~/.config/git/personal), wherever they live
{{- range $globs }}
[includeIf "hasconfig:remote.*.url:{{ . }}"]
	path = personal
{{- end }}
{{- end }}

[commit]
	template = {{ .chezmoi.homeDir }}/.config/git/commit-template

[init]
	defaultBranch = main

[fetch]
	prune = true

[submodule]
	recurse = true

[credential]
{{- if eq .chezmoi.os "darwin" }}
	helper = osxkeychain
{{- else if eq .chezmoi.os "windows" }}
	helper = wincred
{{- else if eq .chezmoi.os "linux" }}
	helper = cache --timeout=3600
{{- end }}

[diff]
	tool = vimdiff

[difftool "vimdiff"]
{{- if eq .chezmoi.os "windows" }}
	cmd = vim -d "$LOCAL" "$REMOTE"
{{- else }}
	cmd = vimdiff "$LOCAL" "$REMOTE"
{{- end }}

[merge]
	tool = vimdiff
	squash = true

[mergetool "vimdiff"]
{{- if eq .chezmoi.os "windows" }}
	cmd = vim -d "$LOCAL" "$REMOTE" "$MERGED"
{{- else }}
	cmd = vimdiff "$LOCAL" "$REMOTE" "$MERGED"
{{- end }}
	trustExitCode = true
