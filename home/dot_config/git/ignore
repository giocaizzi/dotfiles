# Re-include source code and migrations. The secret/token/password/credentials
# patterns above target data files, but also hide source files whose names merely
# contain those words (internal/token/token.go, redact/secret.go) and SQL
# migrations. gitleaks guards real secrets in source, so these stay visible.
# *.db and *.sqlite* stay ignored except under testdata.
# A file cannot be re-included while its parent directory is ignored, so
# directories named like internal/token/ are re-included first; the plural
# secrets/ and credentials/ dirs (where real secret files live) stay ignored.
!*token*/
!*secret*/
!*password*/
!*credentials*/
!*apikey*/
!*api_key*/
secrets/
.secrets/
credentials/
!*.go
!*.py
!*.ts
!*.tsx
!*.js
!*.mjs
!*.rs
!*.sh
!*.ps1
!*.sql
!**/testdata/**
!**/migrations/**
