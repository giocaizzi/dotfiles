# Generated by chezmoi from Bitwarden Secrets Manager — do not edit.
# Change secrets in Bitwarden, then run `chezmoi apply`.
{{ range (includeTemplate "bws-secrets.json" . | fromJson) -}}
{{ if regexMatch "^[A-Za-z_][A-Za-z0-9_]*$" .key -}}
$env:{{ .key }} = '{{ .value | replace "'" "''" }}'
{{ end -}}
{{ end -}}
{{ if and (not (get . "work")) (get . "otelEndpoint") -}}
# guard plugin decision log (giocaizzi/harness): Claude Code and Copilot CLI strip
# OTEL_* from hook environments, so the guard reads these copies.
$env:GUARD_OTEL_EXPORTER_OTLP_ENDPOINT = '{{ .otelEndpoint | replace "'" "''" }}'
$env:GUARD_OTEL_EXPORTER_OTLP_HEADERS = $env:OTEL_EXPORTER_OTLP_HEADERS
$env:GUARD_OTEL_RESOURCE_ATTRIBUTES = 'host.name={{ .chezmoi.hostname }}'
# Agent telemetry for Copilot: VS Code reads COPILOT_OTEL_*; Copilot CLI reads
# only the standard endpoint, set for the copilot command alone.
$env:COPILOT_OTEL_ENABLED = 'true'
$env:COPILOT_OTEL_ENDPOINT = '{{ .otelEndpoint | replace "'" "''" }}'
function copilot {
  $saved = $env:OTEL_EXPORTER_OTLP_ENDPOINT, $env:OTEL_EXPORTER_OTLP_PROTOCOL
  $env:OTEL_EXPORTER_OTLP_ENDPOINT = '{{ .otelEndpoint | replace "'" "''" }}'
  $env:OTEL_EXPORTER_OTLP_PROTOCOL = 'http/protobuf'
  try { & (Get-Command copilot -CommandType Application | Select-Object -First 1) @args }
  finally { $env:OTEL_EXPORTER_OTLP_ENDPOINT, $env:OTEL_EXPORTER_OTLP_PROTOCOL = $saved }
}
{{ end -}}
