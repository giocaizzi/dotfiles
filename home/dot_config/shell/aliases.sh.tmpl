{{- $r := includeTemplate "aliases" (dict "shell" "posix" "ctx" .) | fromJson -}}
# ============================================================================
# SHARED SHELL ALIASES (POSIX)
# ============================================================================
# Rendered by chezmoi from .chezmoidata/aliases.toml — DO NOT EDIT directly.
# Sourced by ~/.bashrc and ~/.zshrc. POSIX-compliant: bash + zsh + sh.
# ============================================================================

# --- ls colours (GNU vs BSD flag, detected at runtime) ---
if ls --color=auto >/dev/null 2>&1; then
	alias ls='ls --color=auto'
else
	alias ls='ls -G'  # BSD ls (macOS)
fi

# --- Registry aliases ---
{{ range $name, $command := $r.aliases -}}
alias {{ $name }}='{{ replace "'" "'\\''" $command }}'
{{ end }}
# --- Refused commands (a function wins over a reinstalled binary) ---
{{ range $name, $block := $r.blocks -}}
{{ $name }}() {
	echo '{{ replace "'" "'\\''" $block.message }}' >&2
	return 1
}
{{ end }}
# --- Python ---
# Only where nothing provides `python` (uv does on full machines)
if ! command -v python >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
	alias python='python3'
fi
{{- if and (eq .chezmoi.os "darwin") (not (get . "light")) (not (get . "work")) }}

# --- Functions (personal Mac) ---
# Swarm secrets sync from Secrets Manager. The token is read from chezmoi when the
# command runs and exists only in that process (never exported to the shell).
rp5-secrets() {
	BWS_ACCESS_TOKEN="$(chezmoi secret keyring get --service=bws --user=access-token)" \
		PI_SSH_USER="${PI_SSH_USER:-$USER}" \
		"$HOME/Documents/github/rp5-homeserver/scripts/create_secrets.sh" "$@"
}
# Infra stack deploy with its file-based secrets written from Secrets Manager (same token).
rp5-sync-infra() {
	BWS_ACCESS_TOKEN="$(chezmoi secret keyring get --service=bws --user=access-token)" \
		PI_SSH_USER="${PI_SSH_USER:-$USER}" DOMAIN="${DOMAIN:?export DOMAIN (the public zone)}" \
		"$HOME/Documents/github/rp5-homeserver/scripts/sync_infra.sh" "$@"
}
{{- end }}
