# tmux >= 3.1 reads this XDG path natively.
# Prefix stays C-b: Ghostty already uses ctrl+a (splits) and ctrl+h/j/k/l.

# psmux advises xterm-256color on Windows.
set -g default-terminal "{{ if eq .chezmoi.os "windows" }}xterm-256color{{ else }}tmux-256color{{ end }}"
# Fixed index: a reload (prefix r) sets it again instead of appending another copy.
set -s terminal-features[100] "*:RGB"
# Claude Code limits itself to 256 colours when $TMUX is set; this env var (process env only) lifts it.
set-environment -g CLAUDE_CODE_TMUX_TRUECOLOR 1
set -g mouse on
set -g history-limit 50000
set -g escape-time 10
set -g focus-events on
{{- if ne .chezmoi.os "windows" }}
# Claude Code (terminal-config docs): Shift+Enter newline and desktop notifications reaching the outer terminal.
set -g allow-passthrough on
set -s extended-keys on
set -s terminal-features[101] "xterm*:extkeys"
{{- end }}
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

# Keep bells audible through the outer terminal; show activity without ringing.
set -g bell-action any
set -g visual-bell off
set -g visual-activity on
set -g activity-action other
setw -g monitor-bell on
setw -g monitor-activity on

# Pane navigation (prefix + h/j/k/l) and splits in the current directory
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R
bind '"' split-window -v -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"
bind r source-file ~/.config/tmux/tmux.conf \; display "reloaded"

# Use the terminal palette so Ghostty's active Catppuccin theme controls colors.
set -g status-style "bg=default,fg=default"
set -g status-interval 5
set -g status-left "#[fg=colour4]└#[fg=colour8] [#[fg=default]󰆍 #S#[fg=colour8]] "
set -g status-right-length 200
{{- if eq .chezmoi.os "windows" }}
set -g status-right "#[fg=colour8][#[fg=default]󰆍 #h#[fg=colour8]] #[fg=colour8][#[fg=default]󰍛 #{window_panes}#[fg=colour8]]#(powershell.exe -NoProfile -File {{ replace "\\" "/" .chezmoi.homeDir }}/.config/tmux/status-right.ps1) #[fg=colour8][#[fg=default]󰥔 %H:%M#[fg=colour8]] "
{{- else }}
set -g status-right "#[fg=colour8][#[fg=default]󰆍 #h#[fg=colour8]] #[fg=colour8][#[fg=default]󰍛 #{window_panes}#[fg=colour8]]#(sh ~/.config/tmux/status-right.sh) #[fg=colour8][#[fg=default]󰥔 %H:%M#[fg=colour8]] "
{{- end }}
setw -g window-status-format "#[fg=colour8] #I:#W#{?window_activity_flag,#[fg=colour3,bold]+,}#{?window_bell_flag,#[fg=colour1,bold]!,}#[fg=colour8] "
setw -g window-status-current-format "#[fg=colour8] #[fg=colour5,bold]#I:#W#{?window_activity_flag,#[fg=colour3,bold]+,}#{?window_bell_flag,#[fg=colour1,bold]!,}#[fg=colour8] "
set -g pane-border-style "fg=colour8"
set -g pane-active-border-style "fg=colour4"
set -g message-style "bg=default,fg=colour3"
set -g mode-style "bg=colour0,fg=colour15"

# Support extended keyboard key encoding (for key combinations)
set -g extended-keys on

