# Readline (bash, Git Bash, other readline programs). Loaded via $INPUTRC,
# set in ~/.profile, since readline has no XDG default path.
$include /etc/inputrc

# Completion
set completion-ignore-case on
set show-all-if-ambiguous on
set colored-stats on
set colored-completion-prefix on
set mark-symlinked-directories on

# Up/Down search history by the typed prefix (like PSReadLine in PowerShell)
"\e[A": history-search-backward
"\e[B": history-search-forward
