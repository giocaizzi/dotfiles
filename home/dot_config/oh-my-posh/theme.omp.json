{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "default",
          "template": "<blue>\u250c</><darkGray>[</>\uf007 {{ .UserName }}@{{ .HostName }}<darkGray>]</>",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "root",
          "style": "plain",
          "foreground": "yellow",
          "template": " <darkGray>[</>\uf0e7 root<darkGray>]</>",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "red",
          "template": " <darkGray>[</>\ue725 {{ .HEAD }}{{ if gt .Ahead 0 }} \u2191{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} \u2193{{ .Behind }}{{ end }}{{ if or .Working.Changed .Staging.Changed }} *{{ end }}<darkGray>]</>",
          "properties": {
            "cache_duration": "none",
            "branch_icon": "",
            "fetch_status": true
          }
        },
        {
          "type": "gcp",
          "min_width": 100,
          "style": "plain",
          "foreground": "yellow",
          "template": "{{ if .Project }} <darkGray>[</>\uf0c2 {{ .Project }}<darkGray>]</>{{ end }}",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "az",
          "min_width": 100,
          "style": "plain",
          "foreground": "blue",
          "template": "{{ if .Name }} <darkGray>[</>\uebd8 {{ .Name }}<darkGray>]</>{{ end }}",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "azd",
          "min_width": 100,
          "style": "plain",
          "foreground": "blue",
          "template": "{{ if .DefaultEnvironment }} <darkGray>[</>\uebd8 azd {{ .DefaultEnvironment }}<darkGray>]</>{{ end }}",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "aws",
          "min_width": 100,
          "style": "plain",
          "foreground": "yellow",
          "template": "{{ if .Profile }} <darkGray>[</>\uf270 {{ .Profile }}{{ if .Region }}@{{ .Region }}{{ end }}<darkGray>]</>{{ end }}",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "kubectl",
          "min_width": 100,
          "style": "plain",
          "foreground": "blue",
          "template": "{{ if .Context }} <darkGray>[</>\ue81d {{ .Context }}{{ if .Namespace }}::{{ .Namespace }}{{ end }}<darkGray>]</>{{ end }}",
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "python",
          "min_width": 70,
          "style": "plain",
          "foreground": "default",
          "template": " <darkGray>[</>\ue235 {{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}<darkGray>]</>",
          "properties": {
            "cache_duration": "none"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "overflow": "break",
      "segments": [
        {
          "type": "sysinfo",
          "min_width": 100,
          "style": "plain",
          "foreground": "default",
          "template": "<darkGray>[</>\uefc5 {{ div ((sub .PhysicalTotalMemory .PhysicalFreeMemory)|float64) 1073741824.0 }}/{{ div .PhysicalTotalMemory 1073741824.0 }}GB<darkGray>]</>",
          "foreground_templates": [
            "{{ if gt .PhysicalPercentUsed 80.0 }}yellow{{ end }}"
          ],
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "battery",
          "min_width": 100,
          "style": "plain",
          "foreground": "default",
          "template": "{{ if not .Error }} <darkGray>[</>{{ if ge .Percentage 88 }}\uf240{{ else if ge .Percentage 63 }}\uf241{{ else if ge .Percentage 38 }}\uf242{{ else if ge .Percentage 13 }}\uf243{{ else }}\uf244{{ end }} {{ .Percentage }}%{{ if eq \"Charging\" .State.String }} \uf1e6{{ end }}<darkGray>]</>{{ end }}",
          "foreground_templates": [
            "{{ if eq \"Charging\" .State.String }}green{{ end }}",
            "{{ if and (eq \"Discharging\" .State.String) (lt .Percentage 20) }}red{{ end }}"
          ],
          "properties": {
            "cache_duration": "none"
          }
        },
        {
          "type": "time",
          "min_width": 100,
          "style": "plain",
          "foreground": "default",
          "template": " <darkGray>[</>\uf017 {{ .CurrentDate | date .Format }}<darkGray>]</>",
          "properties": {
            "cache_duration": "none",
            "time_format": "15:04 Mon 02 Jan"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "path",
          "min_width": 70,
          "style": "plain",
          "foreground": "magenta",
          "template": "<blue>\u251c</><darkGray>[</>\uf07c {{ .Path }}<darkGray>]</>",
          "properties": {
            "cache_duration": "none",
            "style": "full"
          }
        },
        {
          "type": "path",
          "max_width": 69,
          "style": "plain",
          "foreground": "magenta",
          "template": "<blue>\u251c</><darkGray>[</>\uf07c {{ .Path }}<darkGray>]</>",
          "properties": {
            "cache_duration": "none",
            "style": "folder"
          }
        },
        {
          "type": "executiontime",
          "min_width": 70,
          "style": "plain",
          "foreground": "default",
          "template": " <darkGray>[</>\uf520 {{ .FormattedMs }}<darkGray>]</>",
          "properties": {
            "cache_duration": "none",
            "style": "austin",
            "threshold": 500
          }
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "red",
          "template": " <darkGray>[</>\uf071 exit {{ .Code }}<darkGray>]</>",
          "properties": {
            "cache_duration": "none"
          }
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "blue",
          "template": "\u2514\u0394",
          "properties": {
            "cache_duration": "none"
          }
        }
      ]
    }
  ],
  "final_space": true,
  "version": 3
}
