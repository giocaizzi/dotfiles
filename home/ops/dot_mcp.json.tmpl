{{- /* ~/ops workspace servers (.chezmoidata/mcp.toml [mcp.ops]) for Claude Code, Copilot CLI and
       VS Code's Copilot harness. A pre-registered OAuth client gets Claude Code's nested `oauth`
       and Copilot's flat `oauthClientId` + `auth.redirectPort` (each ignores the other's keys;
       Copilot warns that the nested key is deprecated) (docs/OS.md#mcp-servers). */ -}}
{{- $s := includeTemplate "mcp-servers.json" .mcp.ops | fromJson -}}
{{- $out := dict -}}
{{- range $n, $v := $s -}}
{{- if kindIs "string" $v }}{{ $_ := set $out $n (dict "type" "http" "url" $v) }}
{{- else }}{{ $_ := set $out $n (dict "type" "http" "url" $v.url
      "oauth" (dict "clientId" $v.client_id "callbackPort" $v.callback_port)
      "oauthClientId" $v.client_id "oauthPublicClient" false
      "auth" (dict "redirectPort" $v.callback_port)) }}{{ end -}}
{{- end -}}
{{- dict "mcpServers" $out | toPrettyJson }}
