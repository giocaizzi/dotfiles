{{- /* Runs on Unix machines with a harness selected and the agents release: elsewhere it renders empty and chezmoi skips it. */ -}}
{{- $sel := includeTemplate "harnesses" . | trim -}}
{{- $r := get (includeTemplate "releases" . | fromJson) "agents" -}}
{{- if and (ne .chezmoi.os "windows") $sel $r -}}
#!/usr/bin/env bash
# `agents apply`: writes every harness's settings, MCP files, rules, LSP plugin and instruction
# file from ~/.config/agents (config rendered by chezmoi, instruction layers deployed by it).
# Re-runs when any of them or the agents version changes:
# config: {{ includeTemplate "agents-config.toml" . | sha256sum }}
# agents: {{ $r.url }} {{ $r.sha256 }}
{{- range $f := list "core.md" "env.md" "encrypted_private_personal.md.age" "encrypted_private_work.md.age" }}
# {{ $f }}: {{ include (print "dot_config/agents/instructions/" $f) | sha256sum }}
{{- end }}
# Never fails the apply: a missing binary is skipped, agents' own failure is a warning.
# Runbook: docs/OS.md#agents-apply.
exe={{ joinPath .chezmoi.homeDir $r.dest | quote }}
if [ ! -x "$exe" ]; then
	echo "agents apply: $exe not installed yet, skipped (run chezmoi apply again)" >&2
	exit 0
fi
"$exe" apply || echo "warning: agents apply failed (exit $?); run it by hand to see why" >&2
exit 0
{{ end -}}
