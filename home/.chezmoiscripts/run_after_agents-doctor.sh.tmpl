{{- /* Runs on Unix machines with a harness selected and the chezmoi-agents release: elsewhere it renders empty and chezmoi skips it. */ -}}
{{- $sel := includeTemplate "harnesses" . | trim -}}
{{- $r := get (includeTemplate "releases" . | fromJson) "chezmoi-agents" -}}
{{- if and (ne .chezmoi.os "windows") $sel $r -}}
#!/usr/bin/env bash
# `chezmoi agents doctor -q` after every apply and update: warns when a newer or better model or
# config is available. Warns only; reads the model catalog and the cached usage (no network, no
# credentials); prints nothing when there is nothing to say; never fails the apply. A binary
# without the doctor command is skipped silently (its error goes to /dev/null).
# Runbook: docs/OS.md#doctor-chezmoi-agents-doctor.
exe={{ joinPath .chezmoi.homeDir $r.dest | quote }}
[ -x "$exe" ] || exit 0
"$exe" doctor -q -harness {{ $sel | replace " " "," | quote }} 2>/dev/null || true
exit 0
{{ end -}}
