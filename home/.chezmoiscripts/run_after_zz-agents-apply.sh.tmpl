{{- /* Runs on Unix machines with a harness selected and the agents release: elsewhere it renders empty and chezmoi skips it. */ -}}
{{- $sel := includeTemplate "harnesses" . | trim -}}
{{- $r := get (includeTemplate "releases" . | fromJson) "agents" -}}
{{- if and (ne .chezmoi.os "windows") $sel $r -}}
#!/usr/bin/env bash
# After every chezmoi apply: `agents check` on the deployed config (~/.config/agents),
# then `agents apply`, which writes every harness's settings, MCP files, rules, LSP plugin
# and instruction file (config rendered by chezmoi, instruction layers deployed by it).
# Never fails the apply: a missing binary is skipped, a failed check skips the agents
# apply with a warning, and agents' own failure is a warning.
# Runbook: docs/OS.md#agents-apply.
exe={{ joinPath .chezmoi.homeDir $r.dest | quote }}
if [ ! -x "$exe" ]; then
	echo "agents apply: $exe not installed yet, skipped (the next chezmoi apply runs it)" >&2
	exit 0
fi
# Quiet when nothing needs attention: the output is shown only for warnings or errors
# (check) and for any target that is not unchanged (apply).
out=$("$exe" check 2>&1)
rc=$?
if [ "$rc" -ne 0 ] || printf '%s\n' "$out" | grep -q '^!'; then
	printf '%s\n' "$out" >&2
fi
if [ "$rc" -ne 0 ]; then
	echo "warning: agents check failed (exit $rc); agents apply skipped, fix the config and run chezmoi apply again" >&2
	exit 0
fi
out=$("$exe" apply 2>&1)
rc=$?
if [ "$rc" -ne 0 ] || printf '%s\n' "$out" | grep -Eq '^(create|update|drift|refused|error|warning)'; then
	printf '%s\n' "$out"
fi
if [ "$rc" -ne 0 ]; then
	echo "warning: agents apply failed (exit $rc); run it by hand to see why" >&2
fi
exit 0
{{ end -}}
