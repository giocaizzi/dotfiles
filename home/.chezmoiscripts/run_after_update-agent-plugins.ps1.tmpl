{{- /* Runs on Windows machines with a harness selected and the agents release: elsewhere it renders empty and chezmoi skips it. */ -}}
{{- $sel := includeTemplate "harnesses" . | trim -}}
{{- $r := get (includeTemplate "releases" . | fromJson) "agents" -}}
{{- if and (eq .chezmoi.os "windows") $sel $r -}}
# `agents plugins update` after apply: agents owns the plugin registry checkout and throttles
# the pull itself (24h). Non-fatal; warns on failure.
# Runbook: docs/OS.md#agent-plugins-giocaizzi-harness.
$exe = '{{ joinPath .chezmoi.homeDir $r.dest | replace "'" "''" }}'
if (-not (Test-Path -LiteralPath $exe)) { exit 0 }
& $exe plugins update *>$null
if ($LASTEXITCODE -ne 0) { Write-Warning "agents plugins update failed" }
exit 0
{{ end -}}
