{{- /* Runs on Unix machines with vscode only: elsewhere it renders empty and chezmoi skips it. */ -}}
{{- $h := includeTemplate "harnesses" . | splitList " " -}}
{{- if and (ne .chezmoi.os "windows") (has "vscode" $h) -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v code >/dev/null 2>&1; then
	echo "Warning: VS Code extension sync skipped because the code CLI is unavailable." >&2
	exit 0
fi

if ! installed_extensions="$(code --list-extensions)"; then
	echo "Error: unable to list installed VS Code extensions." >&2
	exit 1
fi

while IFS= read -r extension; do
	[ -z "$extension" ] && continue
	if ! grep -Fxqi "$extension" <<<"$installed_extensions"; then
		code --install-extension "$extension"
	fi
done <<'EXTENSIONS'
{{ template "vscode-extensions" . }}
EXTENSIONS
{{ end -}}
