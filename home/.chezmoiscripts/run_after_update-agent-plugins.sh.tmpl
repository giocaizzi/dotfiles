{{- /* Runs on Unix machines with a harness selected and the agents release: elsewhere it renders empty and chezmoi skips it. */ -}}
{{- $sel := includeTemplate "harnesses" . | trim -}}
{{- $r := get (includeTemplate "releases" . | fromJson) "agents" -}}
{{- if and (ne .chezmoi.os "windows") $sel $r -}}
#!/usr/bin/env bash
# `agents plugins update` after apply: agents owns the plugin registry checkout and throttles
# the pull itself (24h). Non-fatal; warns on failure.
# Runbook: docs/OS.md#agent-plugins-giocaizzi-harness.
exe={{ joinPath .chezmoi.homeDir $r.dest | quote }}
[ -x "$exe" ] || exit 0
"$exe" plugins update >/dev/null 2>&1 || echo "warning: agents plugins update failed" >&2
exit 0
{{ end -}}
