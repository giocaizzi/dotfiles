{
  "linux": {
    "claude": {
      "permissions": {
        "allow": [
          "WebSearch",
          "WebFetch",
          "Bash",
          "Bash(gh pr merge * --auto*)"
        ],
        "deny": [
          "Bash(gh pr merge * --admin*)",
          "Read(**/.env)",
          "Read(**/.env.local)",
          "Read(**/.env.*.local)",
          "Read(**/.env.development)",
          "Read(**/.env.production)",
          "Read(**/.env.staging)",
          "Read(**/.env.test)",
          "Read(**/secrets/**)",
          "Read(~/.config/shell/secrets.sh)",
          "Read(~/.config/powershell/secrets.ps1)",
          "Read(**/*.pem)",
          "Read(**/*.key)",
          "Read(**/*.p12)",
          "Read(**/*.pfx)",
          "Read(**/id_rsa*)",
          "Read(**/id_ed25519*)",
          "Read(**/.aws/credentials)",
          "Read(**/.aws/config)",
          "Read(**/.ssh/**)",
          "Read(**/.netrc)",
          "Read(**/.npmrc)",
          "Read(**/.pypirc)",
          "Read(**/credentials.json)",
          "Read(**/service-account*.json)",
          "Read(**/gcp-key*.json)",
          "Read(**/*.kubeconfig)",
          "Read(**/kubeconfig)",
          "Edit(**/.env)",
          "Edit(**/.env.local)",
          "Edit(**/.env.*.local)",
          "Edit(**/.env.development)",
          "Edit(**/.env.production)",
          "Edit(**/.env.staging)",
          "Edit(**/.env.test)",
          "Edit(**/secrets/**)",
          "Edit(~/.config/shell/secrets.sh)",
          "Edit(~/.config/powershell/secrets.ps1)",
          "Edit(**/.aws/credentials)",
          "Edit(**/.ssh/**)",
          "Bash(env)",
          "Bash(printenv:*)",
          "Bash(pipx:*)",
          "Bash(pip:*)",
          "Bash(pip3:*)",
          "Bash(python -m pip:*)",
          "Bash(python3 -m pip:*)"
        ],
        "ask": [
          "Bash(bw)",
          "Bash(bw *)"
        ],
        "defaultMode": "auto"
      },
      "skipAutoPermissionPrompt": true,
      "preferredNotifChannel": "terminal_bell"
    },
    "copilot": {
      "beep": true,
      "subagents": {
        "agents": {
          "dev-tools:scout": {
            "model": "gpt-6-luna",
            "effortLevel": "low"
          },
          "api:api-reviewer": {
            "model": "gpt-6.1-sol",
            "effortLevel": "medium"
          },
          "dev-tools:escalate": {
            "model": "gpt-6-astra",
            "effortLevel": "medium"
          },
          "dev-tools:driver": {
            "model": "gpt-6.1-sol",
            "effortLevel": "medium"
          },
          "dev-tools:reviewer": {
            "model": "gpt-6-luna",
            "effortLevel": "medium"
          },
          "dev-tools:worker": {
            "model": "gpt-6-luna",
            "effortLevel": "medium"
          },
          "factory:verifier": {
            "model": "gpt-6.1-sol",
            "effortLevel": "medium"
          }
        }
      }
    },
    "antigravity": {
      "permissions": {
        "allow": [
          "command(*)",
          "command(gh pr merge * --auto*)",
          "read_url(*)",
          "execute_url(*)",
          "mcp(*)"
        ],
        "deny": [
          "command(gh pr merge * --admin*)",
          "command(env)",
          "command(printenv)",
          "command(printenv *)",
          "command(pipx)",
          "command(pipx *)",
          "command(pip)",
          "command(pip *)",
          "command(pip3)",
          "command(pip3 *)",
          "command(python -m pip *)",
          "command(python3 -m pip *)",
          "read_file(**/.env)",
          "read_file(**/.env.local)",
          "read_file(**/.env.*.local)",
          "read_file(**/.env.development)",
          "read_file(**/.env.production)",
          "read_file(**/.env.staging)",
          "read_file(**/.env.test)",
          "read_file(**/secrets/**)",
          "read_file(~/.config/shell/secrets.sh)",
          "read_file(~/.config/powershell/secrets.ps1)",
          "read_file(**/*.pem)",
          "read_file(**/*.key)",
          "read_file(**/*.p12)",
          "read_file(**/*.pfx)",
          "read_file(**/id_rsa*)",
          "read_file(**/id_ed25519*)",
          "read_file(**/.aws/credentials)",
          "read_file(**/.aws/config)",
          "read_file(**/.ssh/**)",
          "read_file(**/.netrc)",
          "read_file(**/.npmrc)",
          "read_file(**/.pypirc)",
          "read_file(**/credentials.json)",
          "read_file(**/service-account*.json)",
          "read_file(**/gcp-key*.json)",
          "read_file(**/*.kubeconfig)",
          "read_file(**/kubeconfig)",
          "write_file(**/.env)",
          "write_file(**/.env.local)",
          "write_file(**/.env.*.local)",
          "write_file(**/.env.development)",
          "write_file(**/.env.production)",
          "write_file(**/.env.staging)",
          "write_file(**/.env.test)",
          "write_file(**/secrets/**)",
          "write_file(~/.config/shell/secrets.sh)",
          "write_file(~/.config/powershell/secrets.ps1)",
          "write_file(**/.aws/credentials)",
          "write_file(**/.ssh/**)"
        ],
        "ask": [
          "command(bw)",
          "command(bw *)"
        ]
      },
      "agentMode": "auto",
      "toolPermission": "always-proceed",
      "enableTerminalSandbox": false,
      "allowNonWorkspaceAccess": true
    }
  },
  "windowsClaudePermissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash",
