      "Read(~/.config/powershell/secrets.ps1)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.aws/credentials)",
      "Read(**/.aws/config)",
      "Read(**/.ssh/**)",
      "Read(**/.netrc)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/credentials.json)",
      "Read(**/service-account*.json)",
      "Read(**/gcp-key*.json)",
      "Read(**/*.kubeconfig)",
      "Read(**/kubeconfig)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(**/secrets/**)",
      "Edit(~/.config/shell/secrets.sh)",
      "Edit(~/.config/powershell/secrets.ps1)",
      "Edit(**/.aws/credentials)",
      "Edit(**/.ssh/**)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(pipx:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(python -m pip:*)",
      "Bash(python3 -m pip:*)",
      "PowerShell(pipx *)",
      "PowerShell(pip *)",
      "PowerShell(pip3 *)",
      "PowerShell(python -m pip *)",
      "PowerShell(python3 -m pip *)"
    ],
    "ask": [
      "Bash(bw)",
      "Bash(bw *)"
    ],
    "defaultMode": "auto"
  }
}
