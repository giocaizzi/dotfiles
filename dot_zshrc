# ============================================================================
# ZSH CONFIGURATION (Minimal)
# ============================================================================
# Shell-specific features only. Universal config is in ~/.profile
# Note: .zprofile sources .profile for login shells

# ----------------------------------------------------------------------------
# OH MY ZSH
# ----------------------------------------------------------------------------

export ZSH="$HOME/.oh-my-zsh"
export ZSH_DISABLE_COMPFIX=true
export ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"

# Plugins
# No `git` plugin: its ~200 aliases would diverge from the shared shortcuts
plugins=(docker gh)

# Disable auto-update (update manually with: omz update)
zstyle ':omz:update' mode disabled

source "$ZSH/oh-my-zsh.sh"

# ----------------------------------------------------------------------------
# SHARED SNIPPETS
# ----------------------------------------------------------------------------
# Aliases (from .chezmoidata/shortcuts.toml) and fzf defaults + h(). Aliases and
# functions aren't inherited by child shells, so load them in every
# interactive shell rather than once in ~/.profile.
# After Oh My Zsh so these shortcuts win over its git plugin aliases.

for snippet in aliases fzf; do
	[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/shell/$snippet.sh" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/shell/$snippet.sh"
done
unset snippet

# ----------------------------------------------------------------------------
# HISTORY
# ----------------------------------------------------------------------------

HISTSIZE=50000
SAVEHIST=50000
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"

setopt EXTENDED_HISTORY HIST_IGNORE_ALL_DUPS HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE HIST_REDUCE_BLANKS SHARE_HISTORY HIST_VERIFY

# ----------------------------------------------------------------------------
# ZSH OPTIONS
# ----------------------------------------------------------------------------

# Navigation
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS PUSHD_SILENT

# Globbing
setopt EXTENDED_GLOB GLOB_DOTS NO_CASE_GLOB NUMERIC_GLOB_SORT

# Misc
setopt CORRECT INTERACTIVE_COMMENTS NOTIFY

# ----------------------------------------------------------------------------
# FZF & AUTOSUGGESTIONS
# ----------------------------------------------------------------------------

# FZF key bindings (options set in ~/.profile)
if (( $+commands[fzf] )); then
	source <(fzf --zsh)
fi

# Autosuggestions
if [[ -n "$HOMEBREW_PREFIX" && -f "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]]; then
	source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
	ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
	ZSH_AUTOSUGGEST_STRATEGY=(history completion)
fi

# ----------------------------------------------------------------------------
# PROMPT (oh-my-posh)
# ----------------------------------------------------------------------------
# Must be loaded AFTER oh-my-zsh to avoid being overridden

if command -v oh-my-posh &> /dev/null; then
	eval "$(oh-my-posh init zsh --config "${POSH_THEME:-${XDG_CONFIG_HOME:-$HOME/.config}/oh-my-posh/theme.omp.json}")"
fi

# ----------------------------------------------------------------------------
# CUSTOM OVERRIDES
# ----------------------------------------------------------------------------

# Override oh-my-zsh's history alias with fzf version (h is defined in ~/.config/shell/fzf.sh)
unalias history 2>/dev/null
function history() {
	h "$@"
}

# ----------------------------------------------------------------------------
# End of .zshrc
# ----------------------------------------------------------------------------
