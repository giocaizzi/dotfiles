# ============================================================================
# .chezmoiignore — paths to EXCLUDE from chezmoi management
# ============================================================================
# Logic is INVERTED: list entries to ignore. Template-aware.
# Reference: https://chezmoi.io/docs/reference/chezmoiignore/
# ============================================================================

# ----------------------------------------------------------------------------
# Repo meta — never apply
# ----------------------------------------------------------------------------
README.md
AGENTS.md
LICENSE
Makefile
scripts
# Git Bash crash dumps left in the source dir (also git-ignored globally)
*.stackdump
.agents
docs

# Env secrets: rendered from Bitwarden Secrets Manager where this machine has a
# bws project ID (token in the OS keyring) and bws is installed (the first apply
# fetches bws, the next one renders); otherwise hand-edited and untracked (stub by
# run_once_init-untracked-env.*).
{{ $bws := joinPath .chezmoi.homeDir ".local" "bin" (ternary "bws.exe" "bws" (eq .chezmoi.os "windows")) }}
{{ if not (and (get . "bwsProjectId") (stat $bws)) }}
.config/shell/secrets.sh
.config/powershell/secrets.ps1
{{ end }}

# Symlink-only sources: files that exist in the source tree purely as targets
# for symlinks on the OS that uses them, and should never be deployed as
# regular files anywhere.
.config/windows-terminal
.config/powershell/profile.ps1

# Sourcetree and other GUIs rewrite ~/.gitconfig directly. We manage git via
# the XDG location (~/.config/git/config). Both are read by git.
.gitconfig

# ============================================================================
# OS-conditional sections
# Pattern: paths live under the OS's native location and are ignored elsewhere.
#
#   macOS    →  Library/Application Support/...
#   Linux    →  .config/...
#   Windows  →  AppData/... (+ PowerShell profile linked by a script)
# ============================================================================

# --- not macOS ---
{{ if ne .chezmoi.os "darwin" }}
Library
.zshrc
.zprofile
{{ end }}

# --- not Linux ---
# VS Code (Code, Code - Insiders) and Ghostty live under ~/.config on Linux.
# On macOS they live under Library; on Windows under AppData.
{{ if ne .chezmoi.os "linux" }}
.config/ghostty
.config/Code
.config/Code - Insiders
{{ end }}

# --- not Windows ---
{{ if ne .chezmoi.os "windows" }}
AppData
.config/powershell
vimfiles
.chezmoiscripts/init-untracked-env.ps1
.chezmoiscripts/install-pkgs.ps1
.chezmoiscripts/link-pwsh-profile.ps1
.chezmoiscripts/install-harness.ps1
.chezmoiscripts/sync-vscode-extensions.ps1
.chezmoiscripts/claude-mcp-user.ps1
{{ end }}

# --- Light machines (data.light, asked once by `chezmoi init`) ---
# Shell, git, vim and the prompt only: no editors, terminals or AI agents.
# (The font external is skipped in .chezmoiexternal.toml.tmpl.)
# `get` tolerates configs created before the light key existed.
{{ if get . "light" }}
.claude
.copilot
.codex
.pi
.config/opencode
.config/agents
.chezmoiscripts/install-harness.sh
.chezmoiscripts/install-harness.ps1
.chezmoiscripts/claude-mcp-user.sh
.chezmoiscripts/claude-mcp-user.ps1
ops
.config/Code
.config/Code - Insiders
.chezmoiscripts/sync-vscode-extensions.sh
.chezmoiscripts/sync-vscode-extensions.ps1
.config/ghostty
# Outbound-only SSH config; skipping it (the only encrypted file) means light
# machines never need the age key, which decrypts every secret in this repo.
.ssh
{{ end }}

# --- AI harnesses (data.harnesses, chosen by `chezmoi init`; light machines skip them all above) ---
# Only selected harnesses get their configs. A config without the key gets none
# (.chezmoitemplates/harnesses). ~/.config/agents is shared: Claude and Copilot
# symlink to it, Codex, opencode and pi render from the source, so it stays while
# any of them is selected.
{{ $harnesses := includeTemplate "harnesses" . | splitList " " }}
{{ if not (has "claude" $harnesses) }}
.claude
.chezmoiscripts/claude-mcp-user.sh
.chezmoiscripts/claude-mcp-user.ps1
{{ end }}
{{ if not (or (has "claude" $harnesses) (has "copilot" $harnesses)) }}
ops/.mcp.json
{{ end }}
{{ if not (has "codex" $harnesses) }}
ops/.codex
{{ end }}
{{ if not (has "opencode" $harnesses) }}
ops/opencode.json
{{ end }}
{{ if not (has "pi" $harnesses) }}
ops/.pi
{{ end }}
{{ if not (has "vscode" $harnesses) }}
ops/.vscode
{{ end }}
# ~/ops holds personal servers: personal machines only (work PCs get no
# personal account, like the personal vault and telemetry).
{{ if get . "work" }}
ops
{{ end }}
{{ if not (has "copilot" $harnesses) }}
.copilot
{{ end }}
{{ if not (has "vscode" $harnesses) }}
.config/Code
.config/Code - Insiders
Library/Application Support/Code
Library/Application Support/Code - Insiders
AppData/Roaming/Code
AppData/Roaming/Code - Insiders
.chezmoiscripts/sync-vscode-extensions.sh
.chezmoiscripts/sync-vscode-extensions.ps1
{{ end }}
{{ if not (has "codex" $harnesses) }}
.codex
{{ end }}
{{ if not (has "opencode" $harnesses) }}
.config/opencode
{{ end }}
{{ if not (has "pi" $harnesses) }}
.pi
{{ end }}
{{ if not (or (has "claude" $harnesses) (has "copilot" $harnesses) (has "codex" $harnesses) (has "opencode" $harnesses) (has "pi" $harnesses)) }}
.config/agents
{{ end }}
{{ if not (or (has "codex" $harnesses) (has "opencode" $harnesses) (has "pi" $harnesses)) }}
.chezmoiscripts/install-harness.sh
.chezmoiscripts/install-harness.ps1
{{ end }}

# Personal-email override only where personal remotes are configured (work machines)
{{ if not (or (get . "githubUser") (get . "personalGitRemote")) }}
.config/git/personal
{{ end }}

# --- Windows only ---
# Vim on Windows reads ~/vimfiles/vimrc (symlink → dot_config/vim/vimrc), not
# the XDG path. Bash setup scripts are Unix-only. The .config/shell snippets and POSIX rc
# files (.profile, .bashrc, .bash_profile) ARE kept so Git Bash and WSL users
# get the same aliases/PATH as native Unix.
{{ if eq .chezmoi.os "windows" }}
.config/vim
.config/tmux
.chezmoiscripts/init-untracked-env.sh
.chezmoiscripts/create-xdg-dirs.sh
.chezmoiscripts/install-pkgs.sh
.chezmoiscripts/install-harness.sh
.chezmoiscripts/sync-vscode-extensions.sh
.chezmoiscripts/claude-mcp-user.sh
{{ end }}
